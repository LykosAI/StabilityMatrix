<controls:UserControlBase
    x:Class="StabilityMatrix.Avalonia.Views.Settings.AnalyticsSettingsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
    xmlns:controls="clr-namespace:StabilityMatrix.Avalonia.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
    xmlns:lang="clr-namespace:StabilityMatrix.Avalonia.Languages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="clr-namespace:StabilityMatrix.Avalonia.ViewModels.Settings"
    xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    xmlns:vm="clr-namespace:StabilityMatrix.Avalonia.ViewModels"
    d:DesignHeight="750"
    d:DesignWidth="800"
    x:DataType="settings:AnalyticsSettingsViewModel"
    mc:Ignorable="d">
    <controls:UserControlBase.Styles>
        <Style Selector="avaloniaEdit|TextEditor.exampleTelemetry">
            <Setter Property="Margin" Value="16,0,16,16" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="#33000000" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Menlo,Monospace,DejaVu Sans Mono,monospace" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SyntaxHighlighting" Value="JavaScript" />
        </Style>
    </controls:UserControlBase.Styles>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8,8" Spacing="4">
            <!--  Master switch: the daily launch ping every category rides on  -->
            <ui:SettingsExpander
                Margin="8,0,8,4"
                Description="{x:Static lang:Resources.Text_AnalyticsLaunchDataDescription}"
                Header="{x:Static lang:Resources.Label_UsageData}">
                <ui:SettingsExpander.IconSource>
                    <fluent:SymbolIconSource IconVariant="Filled" Symbol="Box" />
                </ui:SettingsExpander.IconSource>
                <ui:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding IsUsageDataEnabled, Mode=TwoWay}" />
                </ui:SettingsExpander.Footer>
                <ui:SettingsExpanderItem
                    Content="{x:Static lang:Resources.Label_InstallationId}"
                    Description="{x:Static lang:Resources.Text_AnalyticsInstallationIdDescription}"
                    IsVisible="{Binding IsUsageDataEnabled}">
                    <ui:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SelectableTextBlock
                                VerticalAlignment="Center"
                                FontFamily="Cascadia Code,Consolas,Menlo,Monospace,DejaVu Sans Mono,monospace"
                                Foreground="{DynamicResource TextFillColorSecondary}"
                                Text="{Binding InstallationIdDisplay}" />
                            <Button Command="{Binding ResetInstallationIdCommand}" Content="{x:Static lang:Resources.Action_Reset}" />
                        </StackPanel>
                    </ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>
                <ui:SettingsExpanderItem Padding="8">
                    <StackPanel>
                        <TextBlock Margin="8" Text="{x:Static lang:Resources.Label_ExampleTelemetry}" />
                        <avaloniaEdit:TextEditor Classes="exampleTelemetry" Document="{Binding LaunchExampleDocument}" />
                    </StackPanel>
                </ui:SettingsExpanderItem>
            </ui:SettingsExpander>

            <!--  One toggle per category  -->
            <ItemsControl IsEnabled="{Binding IsUsageDataEnabled}" ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AnalyticsCategoryViewModel">
                        <ui:SettingsExpander
                            Margin="8,0,8,4"
                            Description="{Binding Description}"
                            Header="{Binding Title}"
                            IconSource="{Binding IconSource}">
                            <ui:SettingsExpander.Footer>
                                <ToggleSwitch IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                            </ui:SettingsExpander.Footer>
                            <ui:SettingsExpanderItem Padding="8">
                                <StackPanel>
                                    <TextBlock Margin="8" Text="{x:Static lang:Resources.Label_ExampleTelemetry}" />
                                    <avaloniaEdit:TextEditor Classes="exampleTelemetry" Document="{Binding ExampleDocument}" />
                                </StackPanel>
                            </ui:SettingsExpanderItem>
                        </ui:SettingsExpander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ui:InfoBar
                Title="{x:Static lang:Resources.Text_AnalyticsDataPrivacyInfo}"
                Margin="8,0,8,4"
                IsClosable="False"
                IsOpen="True"
                Severity="Success">
                <ui:InfoBar.IconSource>
                    <fluent:SymbolIconSource IconVariant="Filled" Symbol="Shield" />
                </ui:InfoBar.IconSource>
            </ui:InfoBar>

            <controls:HyperlinkIconButton
                Margin="0,16"
                Content="{x:Static lang:Resources.Label_PrivacyPolicy}"
                NavigateUri="https://lykos.ai/privacy" />
        </StackPanel>
    </ScrollViewer>
</controls:UserControlBase>
