<controls:UserControlBase
    x:Class="StabilityMatrix.Avalonia.Views.Dialogs.NewOneClickInstallDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:StabilityMatrix.Avalonia.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:StabilityMatrix.Avalonia.ViewModels.Dialogs"
    xmlns:input="clr-namespace:FluentAvalonia.UI.Input;assembly=FluentAvalonia"
    xmlns:lang="clr-namespace:StabilityMatrix.Avalonia.Languages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mocks="clr-namespace:StabilityMatrix.Avalonia.DesignData"
    xmlns:models="clr-namespace:StabilityMatrix.Core.Models;assembly=StabilityMatrix.Core"
    xmlns:packages="clr-namespace:StabilityMatrix.Core.Models.Packages;assembly=StabilityMatrix.Core"
    xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    d:DataContext="{x:Static mocks:DesignData.NewOneClickInstallViewModel}"
    d:DesignHeight="725"
    d:DesignWidth="700"
    x:DataType="dialogs:NewOneClickInstallViewModel"
    mc:Ignorable="d">

    <controls:UserControlBase.Resources>
        <input:StandardUICommand x:Key="InstallPackageCommand" Command="{Binding InstallPackageCommand}" />

        <DataTemplate x:Key="PackageTemplate" x:DataType="packages:BasePackage">
            <Button
                Margin="4"
                Padding="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Classes="transparent-full"
                Command="{StaticResource InstallPackageCommand}"
                CommandParameter="{Binding}"
                CornerRadius="8">
                <controls:Card Padding="8,0">

                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <controls:BetterAdvancedImage
                            Grid.Column="0"
                            MaxWidth="96"
                            MaxHeight="96"
                            CornerRadius="4"
                            Source="{Binding PreviewImageUri}"
                            Stretch="UniformToFill" />
                        <StackPanel Grid.Column="1" Orientation="Vertical">
                            <TextBlock
                                Margin="16,8,0,0"
                                FontSize="20"
                                FontWeight="Light"
                                Text="{Binding DisplayName}" />

                            <TextBlock
                                Margin="16,0,0,0"
                                FontSize="13"
                                FontWeight="Light"
                                Text="{Binding ByAuthor}" />

                            <TextBlock
                                Margin="16,8,0,8"
                                FontSize="14"
                                FontWeight="Light"
                                Text="{Binding Blurb}"
                                TextWrapping="Wrap" />

                            <controls:Card
                                Margin="16,0,0,8"
                                Padding="4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Tag="{Binding InstallerSortOrder}">

                                <controls:Card.Styles>
                                    <Style Selector="controls|Card[Tag=ReallyRecommended]">
                                        <Setter Property="Background" Value="{DynamicResource ThemeGreenColorTransparent}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeGreenColorTransparent}" />
                                        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
                                        </Style>
                                        <Setter Property="Content">
                                            <Template>
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontWeight="Medium"
                                                    Text="Recommended"
                                                    TextAlignment="Center" />
                                            </Template>
                                        </Setter>
                                    </Style>
                                    <Style Selector="controls|Card[Tag=Recommended]">
                                        <Setter Property="Background" Value="{DynamicResource ThemeGreenColorTransparent}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeGreenColorTransparent}" />
                                        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
                                        </Style>
                                        <Setter Property="Content">
                                            <Template>
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontWeight="Medium"
                                                    Text="Recommended"
                                                    TextAlignment="Center" />
                                            </Template>
                                        </Setter>
                                    </Style>
                                    <Style Selector="controls|Card[Tag=Simple]">
                                        <Setter Property="Background" Value="{DynamicResource ThemeDarkBlueColor}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeDarkBlueColor}" />
                                        <Setter Property="Content">
                                            <Template>
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontWeight="Medium"
                                                    Text="Simple"
                                                    TextAlignment="Center" />
                                            </Template>
                                        </Setter>
                                    </Style>
                                    <Style Selector="controls|Card[Tag=Advanced]">
                                        <Setter Property="Background" Value="{DynamicResource ThemeOrangeColor}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeOrangeColor}" />
                                        <Setter Property="Foreground" Value="Black" />
                                        <Setter Property="Content">
                                            <Template>
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontWeight="Medium"
                                                    Text="Advanced"
                                                    TextAlignment="Center" />
                                            </Template>
                                        </Setter>
                                    </Style>
                                    <Style Selector="controls|Card[Tag=InferenceCompatible]">
                                        <Setter Property="Background" Value="{DynamicResource ThemePurpleColor}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemePurpleColor}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="Content">
                                            <Template>
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontWeight="Medium"
                                                    Text="Inference Compatible"
                                                    TextAlignment="Center" />
                                            </Template>
                                        </Setter>
                                    </Style>
                                    <Style Selector="controls|Card">
                                        <Setter Property="Background" Value="{DynamicResource ThemeDarkRedColor}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeDarkRedColor}" />
                                        <Setter Property="Content">
                                            <Template>
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontWeight="Medium"
                                                    Text="Expert"
                                                    TextAlignment="Center" />
                                            </Template>
                                        </Setter>
                                    </Style>
                                </controls:Card.Styles>
                            </controls:Card>
                        </StackPanel>

                        <ui:SymbolIcon
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="24"
                            Symbol="ChevronRight" />
                    </Grid>
                </controls:Card>
            </Button>
        </DataTemplate>
    </controls:UserControlBase.Resources>

    <StackPanel Margin="8" Orientation="Vertical">
        <TextBlock
            Margin="8,0,8,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="36"
            FontWeight="Light"
            Text="{x:Static lang:Resources.Text_WelcomeToStabilityMatrix}"
            TextWrapping="Wrap" />
        <TextBlock
            Margin="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            FontSize="16"
            FontWeight="Light"
            Text="{x:Static lang:Resources.Text_OneClickInstaller_SubHeader}"
            TextAlignment="Center"
            TextWrapping="Wrap" />

        <ScrollViewer Height="575" Padding="8,0">
            <ItemsRepeater Name="PackagesRepeater" ItemsSource="{Binding ShownPackages}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <StaticResource ResourceKey="PackageTemplate" />
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <ui:TeachingTip
            Name="InferenceTeachingTip"
            Title="Use ComfyUI with Inference"
            MinWidth="100"
            Margin="8,0,0,0"
            ActionButtonCommand="{Binding InstallComfyForInferenceCommand}"
            ActionButtonContent="{x:Static lang:Resources.Action_Install}"
            CloseButtonContent="{x:Static lang:Resources.Action_Close}"
            PlacementMargin="0,0,0,0"
            PreferredPlacement="RightTop"
            Subtitle="A new built-in native Stable Diffusion experience, powered by ComfyUI"
            TailVisibility="Auto">
            <ui:TeachingTip.HeroContent>
                <controls:BetterAdvancedImage RenderOptions.BitmapInterpolationMode="HighQuality" Source="https://cdn.lykos.ai/static/sc-inference-drag-load.gif" />
            </ui:TeachingTip.HeroContent>
        </ui:TeachingTip>

        <Grid Margin="0,4" ColumnDefinitions="Auto, *">
            <ToggleSwitch
                Margin="6,0"
                IsChecked="{Binding ShowIncompatiblePackages}"
                OffContent="Show All Packages"
                OnContent="Show All Packages" />
            <Button
                Grid.Column="0"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
                Command="{Binding OnCloseButtonClick}"
                Content="{x:Static lang:Resources.Label_SkipSetup}" />
        </Grid>
    </StackPanel>
</controls:UserControlBase>
