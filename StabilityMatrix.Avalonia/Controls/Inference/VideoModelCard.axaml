<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StabilityMatrix.Avalonia.Controls"
    xmlns:converters="clr-namespace:StabilityMatrix.Avalonia.Converters"
    xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
    xmlns:inference="clr-namespace:StabilityMatrix.Avalonia.ViewModels.Inference"
    xmlns:inferenceModels="clr-namespace:StabilityMatrix.Avalonia.Models.Inference"
    xmlns:lang="clr-namespace:StabilityMatrix.Avalonia.Languages"
    xmlns:mocks="clr-namespace:StabilityMatrix.Avalonia.DesignData"
    xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    x:DataType="inference:VideoModelCardViewModel">
    <Design.PreviewWith>
        <Panel Width="400" Height="400">
            <controls:VideoModelCard DataContext="{x:Static mocks:DesignData.VideoModelCardViewModel}" />
        </Panel>
    </Design.PreviewWith>

    <Styles.Resources>
        <converters:EnumToBooleanConverter x:Key="EnumBoolConverter" />
        <fluent:SymbolIconSource
            x:Key="IconCube"
            IconVariant="Filled"
            Symbol="Cube" />
        <fluent:SymbolIconSource
            x:Key="IconQuestionCircle"
            IconVariant="Filled"
            Symbol="QuestionCircle" />
        <fluent:SymbolIconSource
            x:Key="IconSparkle"
            IconVariant="Filled"
            Symbol="Sparkle" />
        <fluent:SymbolIconSource
            x:Key="IconTableCellEdit"
            IconVariant="Filled"
            Symbol="TableCellEdit" />
    </Styles.Resources>

    <Style Selector="controls|VideoModelCard">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <controls:Card Padding="12">
                    <StackPanel Spacing="0">
                        <!--  High-Noise / primary model (relabels to "High-Noise" in dual-expert mode)  -->
                        <Grid ColumnDefinitions="90,*,Auto" ColumnSpacing="4">
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="{Binding PrimaryModelLabel}"
                                TextAlignment="Left" />

                            <controls:BetterComboBox
                                Grid.Column="1"
                                Padding="8,6,4,6"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{Binding ClientManager.UnetModels}"
                                SelectedItem="{Binding SelectedModel}"
                                Theme="{StaticResource BetterComboBoxHybridModelTheme}" />

                            <!--  Browse + Recommended + Settings  -->
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Stretch"
                                Orientation="Horizontal"
                                Spacing="4">
                                <Button
                                    VerticalAlignment="Stretch"
                                    Command="{Binding OpenModelPickerCommand}"
                                    ToolTip.Tip="Browse all models">
                                    <fluent:SymbolIcon FontSize="16" Symbol="Search" />
                                </Button>
                                <Button
                                    VerticalAlignment="Stretch"
                                    IsVisible="{Binding ShowModelOptionsButton}"
                                    ToolTip.Tip="Model options">
                                    <ui:SymbolIcon FontSize="16" Symbol="Setting" />
                                    <Button.Flyout>
                                        <ui:FAMenuFlyout Placement="BottomEdgeAlignedLeft">
                                            <ui:ToggleMenuFlyoutItem
                                                IconSource="{StaticResource IconCube}"
                                                IsChecked="{Binding IsLowNoiseModelEnabled}"
                                                IsVisible="{Binding ShowMoeExpertControls}"
                                                Text="Dual expert (high / low noise)"
                                                ToolTip.Tip="Wan 2.2 14B MoE: run a high-noise expert then hand off to a low-noise expert for a two-pass generation." />
                                            <ui:MenuFlyoutSeparator IsVisible="{Binding ShowLowNoiseSectionsSeparator}" />
                                            <ui:MenuFlyoutSubItem
                                                IsVisible="{Binding ShowLatentSourceMenu}"
                                                Text="5B TI2V Latent"
                                                ToolTip.Tip="The Wan 2.2 5B model needs a different empty latent than the 14B / 2.1 models. Auto picks it from the selected model name; override if a renamed file is guessed wrong.">
                                                <ui:RadioMenuFlyoutItem
                                                    GroupName="WanLatentSource"
                                                    IsChecked="{Binding LatentSourceMode, Converter={StaticResource EnumBoolConverter}, ConverterParameter={x:Static inference:WanLatentSourceMode.Auto}}"
                                                    Text="Auto-detect" />
                                                <ui:RadioMenuFlyoutItem
                                                    GroupName="WanLatentSource"
                                                    IsChecked="{Binding LatentSourceMode, Converter={StaticResource EnumBoolConverter}, ConverterParameter={x:Static inference:WanLatentSourceMode.Wan22FiveB}}"
                                                    Text="Force Wan 2.2 5B" />
                                                <ui:RadioMenuFlyoutItem
                                                    GroupName="WanLatentSource"
                                                    IsChecked="{Binding LatentSourceMode, Converter={StaticResource EnumBoolConverter}, ConverterParameter={x:Static inference:WanLatentSourceMode.Legacy}}"
                                                    Text="Force Wan 2.1 / 14B" />
                                            </ui:MenuFlyoutSubItem>
                                        </ui:FAMenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!--  Workflow profile (model family)  -->
                        <Grid
                            Margin="0,8,0,0"
                            ColumnDefinitions="90,*,Auto"
                            ColumnSpacing="4">
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="Workflow"
                                TextAlignment="Left"
                                ToolTip.Tip="The model family this tab generates with. Auto detects it from the selected model." />
                            <controls:BetterComboBox
                                Grid.Column="1"
                                Padding="8,6,4,6"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{Binding WorkflowProfiles}"
                                SelectedItem="{Binding SelectedWorkflowProfile}">
                                <controls:BetterComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="inferenceModels:VideoWorkflowProfile">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </controls:BetterComboBox.ItemTemplate>
                                <controls:BetterComboBox.SelectionBoxItemTemplate>
                                    <DataTemplate x:DataType="inferenceModels:VideoWorkflowProfile">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </controls:BetterComboBox.SelectionBoxItemTemplate>
                            </controls:BetterComboBox>
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Stretch"
                                Command="{Binding ApplyRecommendedDefaultsCommand}"
                                IsEnabled="{Binding HasRecommendedDefaults}"
                                ToolTip.Tip="{Binding RecommendedDefaultsToolTip}">
                                <fluent:SymbolIcon FontSize="16" Symbol="Sparkle" />
                            </Button>
                        </Grid>
                        <TextBlock
                            Margin="94,4,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            IsVisible="{Binding ShowWorkflowProfileStatus}"
                            Text="{Binding WorkflowProfileStatusText}" />

                        <!--  Nudge: selected model looks like a 14B MoE expert, offer to enable the pair  -->
                        <controls:SmolInfoBar
                            Margin="0,8,0,0"
                            ActionCommand="{Binding EnableLowNoiseExpertCommand}"
                            ActionText="Enable"
                            CloseCommand="{Binding DismissLowNoisePromptCommand}"
                            IsOpen="{Binding ShowEnableLowNoisePrompt}"
                            Message="This looks like a Wan 2.2 14B expert that pairs with a second one"
                            Severity="Informational" />

                        <!--  Low-Noise expert (Wan 2.2 14B MoE, toggled via "Dual expert")  -->
                        <Grid
                            Margin="0,8,0,0"
                            ColumnDefinitions="90,*,Auto"
                            ColumnSpacing="4"
                            IsVisible="{Binding ShowLowNoiseSections}">
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="Low-Noise"
                                TextAlignment="Left"
                                ToolTip.Tip="Optional second Wan 2.2 14B expert that refines the high-noise pass. Leave empty to generate with a single model." />
                            <controls:BetterComboBox
                                Grid.Column="1"
                                Padding="8,6,4,6"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{Binding ClientManager.UnetModels}"
                                SelectedItem="{Binding SelectedLowNoiseModel}"
                                Theme="{StaticResource BetterComboBoxHybridModelTheme}" />
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Stretch"
                                Command="{Binding OpenLowNoiseModelPickerCommand}"
                                ToolTip.Tip="Browse all models">
                                <fluent:SymbolIcon FontSize="16" Symbol="Search" />
                            </Button>
                        </Grid>

                        <!--  MoE boundary (dual-expert only)  -->
                        <Grid
                            Margin="0,8,0,0"
                            ColumnDefinitions="90,*"
                            ColumnSpacing="4"
                            IsVisible="{Binding ShowLowNoiseSections}">
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="Boundary"
                                ToolTip.Tip="Fraction of sampling steps run by the high-noise expert before handing off to the low-noise expert. 0.5 splits the steps evenly." />
                            <ui:NumberBox
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Maximum="1"
                                Minimum="0"
                                SelectionHighlightColor="Transparent"
                                SimpleNumberFormat="F2"
                                SmallChange="0.05"
                                SpinButtonPlacementMode="Inline"
                                ToolTip.Tip="Fraction of steps run by the high-noise expert before switching to the low-noise expert."
                                Value="{Binding MoeBoundary}" />
                        </Grid>

                        <!--  Advanced (precision, VAE, text encoder, shift)  -->
                        <Expander
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            Header="Advanced"
                            IsExpanded="{Binding IsAdvancedExpanded}">
                            <StackPanel Margin="0,4,0,0" Spacing="8">
                                <!--  Precision  -->
                                <Grid ColumnDefinitions="90,*" ColumnSpacing="4">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="Precision"
                                        TextAlignment="Left"
                                        ToolTip.Tip="Weight precision the model loads at. fp8 variants use much less VRAM with a small quality tradeoff; 'default' loads at full precision." />
                                    <ui:FAComboBox
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        IsTextSearchEnabled="True"
                                        ItemsSource="{Binding WeightDTypes}"
                                        SelectedItem="{Binding SelectedDType}" />
                                </Grid>

                                <!--  VAE  -->
                                <Grid ColumnDefinitions="90,*,Auto" ColumnSpacing="4">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="{x:Static lang:Resources.Label_VAE}"
                                        TextAlignment="Left"
                                        ToolTip.Tip="Decodes the generated latents into the final video frames. Use the VAE that matches your model family." />
                                    <controls:FADownloadableComboBox
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        DisplayMemberBinding="{Binding ShortDisplayName}"
                                        IsTextSearchEnabled="True"
                                        ItemsSource="{Binding ClientManager.VaeModels}"
                                        SelectedItem="{Binding SelectedVae}" />
                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Stretch"
                                        Command="{Binding OpenVaePickerCommand}"
                                        ToolTip.Tip="Browse all VAE models">
                                        <fluent:SymbolIcon FontSize="16" Symbol="Search" />
                                    </Button>
                                </Grid>

                                <!--  Audio VAE (families with native audio)  -->
                                <Grid
                                    ColumnDefinitions="90,*,Auto"
                                    ColumnSpacing="4"
                                    IsVisible="{Binding ShowAudioVae}">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="Audio VAE"
                                        TextAlignment="Left"
                                        ToolTip.Tip="Decodes the generated soundtrack (MiniMax H3 outputs native stereo audio). Optional — leave empty for video-only output. Audio needs the MP4 output format." />
                                    <controls:FADownloadableComboBox
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        DisplayMemberBinding="{Binding ShortDisplayName}"
                                        IsTextSearchEnabled="True"
                                        ItemsSource="{Binding ClientManager.VaeModels}"
                                        SelectedItem="{Binding SelectedAudioVae}" />
                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Stretch"
                                        Command="{Binding OpenAudioVaePickerCommand}"
                                        ToolTip.Tip="Browse all VAE models">
                                        <fluent:SymbolIcon FontSize="16" Symbol="Search" />
                                    </Button>
                                </Grid>

                                <!--  Text Encoder  -->
                                <Grid ColumnDefinitions="90,*,Auto" ColumnSpacing="4">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="Text Encoder"
                                        TextAlignment="Left"
                                        ToolTip.Tip="Turns your prompt text into conditioning the model understands. Use the text encoder that matches your model family." />
                                    <controls:BetterDownloadableComboBox
                                        Grid.Column="1"
                                        Padding="8,6,4,6"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{Binding ClientManager.ClipModels}"
                                        SelectedItem="{Binding SelectedClipModel}"
                                        Theme="{StaticResource BetterComboBoxHybridModelTheme}" />
                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Stretch"
                                        Command="{Binding OpenClipPickerCommand}"
                                        ToolTip.Tip="Browse all CLIP models">
                                        <fluent:SymbolIcon FontSize="16" Symbol="Search" />
                                    </Button>
                                </Grid>

                                <!--  CLIP Vision (image-to-video, families that condition on it)  -->
                                <Grid
                                    ColumnDefinitions="90,*,Auto"
                                    ColumnSpacing="4"
                                    IsVisible="{Binding ShowClipVisionRow}">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="CLIP Vision"
                                        TextAlignment="Left" />
                                    <controls:BetterDownloadableComboBox
                                        Grid.Column="1"
                                        Padding="8,6,4,6"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{Binding ClientManager.ClipVisionModels}"
                                        SelectedItem="{Binding SelectedClipVisionModel}"
                                        Theme="{StaticResource BetterComboBoxHybridModelTheme}" />
                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Stretch"
                                        Command="{Binding OpenClipVisionPickerCommand}"
                                        ToolTip.Tip="Browse all CLIP Vision models">
                                        <fluent:SymbolIcon FontSize="16" Symbol="Search" />
                                    </Button>
                                </Grid>

                                <!--  Shift (families that sample via ModelSamplingSD3)  -->
                                <Grid
                                    ColumnDefinitions="90,*"
                                    ColumnSpacing="4"
                                    IsVisible="{Binding ShowShiftControl}">
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Text="Shift"
                                        ToolTip.Tip="Shifts the noise schedule (ModelSamplingSD3). Higher values spend more sampling on the high-noise (motion/structure) stage. 8.0 is the Wan default." />
                                    <ui:NumberBox
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        SelectionHighlightColor="Transparent"
                                        SimpleNumberFormat="F2"
                                        SmallChange="0.25"
                                        SpinButtonPlacementMode="Inline"
                                        Value="{Binding Shift}" />
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!--  High-Noise LoRAs (primary model; title relabels in dual-expert mode)  -->
                        <controls:StackEditableCard Margin="0,8,0,0" DataContext="{Binding ExtraNetworksStackCardViewModel}" />

                        <!--  Low-Noise LoRAs (low-noise expert, Wan 2.2 14B)  -->
                        <Panel IsVisible="{Binding ShowLowNoiseSections}">
                            <controls:StackEditableCard Margin="0,8,0,0" DataContext="{Binding LowNoiseExtraNetworksStackCardViewModel}" />
                        </Panel>

                        <!--  Nudge: an enabled LoRA looks like a few-step lightning LoRA but CFG is still > 1  -->
                        <controls:SmolInfoBar
                            Margin="0,8,0,0"
                            ActionCommand="{Binding ApplyLightningDefaultsCommand}"
                            ActionText="Apply"
                            CloseCommand="{Binding DismissLightningPromptCommand}"
                            IsOpen="{Binding ShowLightningCfgPrompt}"
                            Message="{Binding LightningCfgPromptText}"
                            Severity="Informational" />
                    </StackPanel>
                </controls:Card>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>