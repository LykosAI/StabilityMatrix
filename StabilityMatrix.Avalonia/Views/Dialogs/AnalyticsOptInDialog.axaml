<controls:UserControlBase
    x:Class="StabilityMatrix.Avalonia.Views.Dialogs.AnalyticsOptInDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="https://github.com/projektanker/icons.avalonia"
    xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
    xmlns:controls="clr-namespace:StabilityMatrix.Avalonia.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:StabilityMatrix.Avalonia.ViewModels.Dialogs"
    xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
    xmlns:lang="clr-namespace:StabilityMatrix.Avalonia.Languages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mocks="clr-namespace:StabilityMatrix.Avalonia.DesignData"
    xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    xmlns:vm="clr-namespace:StabilityMatrix.Avalonia.ViewModels"
    d:DataContext="{Binding [AnalyticsOptInViewModel], Source={x:Static mocks:DesignData.Types}}"
    d:DesignHeight="700"
    d:DesignWidth="650"
    x:DataType="dialogs:AnalyticsOptInViewModel"
    mc:Ignorable="d">
    <StackPanel MaxWidth="620" Spacing="4">
        <avalonia:Icon
            Margin="16,16,16,0"
            FontSize="48"
            Value="fa-solid fa-chart-simple" />
        <TextBlock
            Margin="4,4,4,12"
            Text="{x:Static lang:Resources.Label_Analytics}"
            TextAlignment="Center"
            Theme="{DynamicResource TitleTextBlockStyle}" />
        <TextBlock
            Margin="4"
            FontSize="15"
            FontWeight="Light"
            Text="{x:Static lang:Resources.Text_AnalyticsDescription}"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Theme="{DynamicResource BodyTextBlockStyle}" />

        <ui:InfoBar
            Margin="8,8,8,4"
            IsClosable="False"
            IsOpen="{Binding IsConsentUpdate}"
            Message="{x:Static lang:Resources.Text_AnalyticsConsentUpdated}"
            Severity="Informational" />

        <!--  Tick what to share; select a row to preview its document  -->
        <ListBox
            Margin="8,8,8,0"
            ItemsSource="{Binding Categories}"
            SelectedItem="{Binding SelectedCategory}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:AnalyticsCategoryViewModel">
                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
                        <CheckBox
                            Grid.Column="0"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                        <ui:IconSourceElement
                            Grid.Column="1"
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            IconSource="{Binding IconSource}" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorTertiary}"
                                Text="{Binding Description}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock
            Margin="0,12,0,4"
            FontWeight="Light"
            Text="{x:Static lang:Resources.Label_ExampleTelemetry}"
            TextAlignment="Center" />
        <TextBlock
            Margin="0,0,0,4"
            FontSize="12"
            Foreground="{DynamicResource TextFillColorTertiary}"
            Text="{x:Static lang:Resources.Text_AnalyticsSelectCategoryHint}"
            TextAlignment="Center" />
        <avaloniaEdit:TextEditor
            MaxHeight="220"
            Margin="16,0,16,8"
            Padding="8"
            Background="#33000000"
            BorderThickness="0"
            CornerRadius="8"
            Document="{Binding SelectedCategory.ExampleDocument}"
            FontFamily="Cascadia Code,Consolas,Menlo,Monospace,DejaVu Sans Mono,monospace"
            FontSize="13"
            IsReadOnly="True"
            SyntaxHighlighting="JavaScript" />

        <controls:HyperlinkIconButton
            Margin="0,4"
            HorizontalAlignment="Center"
            Content="{x:Static lang:Resources.Label_PrivacyPolicy}"
            NavigateUri="https://lykos.ai/privacy" />

        <TextBlock
            Margin="4,0,4,8"
            Foreground="{DynamicResource TextFillColorTertiary}"
            Text="{Binding ChangeThisBehaviorInSettings}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
    </StackPanel>
</controls:UserControlBase>
