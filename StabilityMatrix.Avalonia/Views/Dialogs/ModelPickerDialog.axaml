<controls:UserControlBase
    x:Class="StabilityMatrix.Avalonia.Views.Dialogs.ModelPickerDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:checkpointManager="clr-namespace:StabilityMatrix.Avalonia.ViewModels.CheckpointManager"
    xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=System.ComponentModel.TypeConverter"
    xmlns:controls="clr-namespace:StabilityMatrix.Avalonia.Controls"
    xmlns:converters="clr-namespace:StabilityMatrix.Avalonia.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:StabilityMatrix.Avalonia.ViewModels.Dialogs"
    xmlns:fluentIcons="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
    xmlns:helpers="clr-namespace:StabilityMatrix.Avalonia.Helpers"
    xmlns:labs="clr-namespace:Avalonia.Labs.Controls;assembly=Avalonia.Labs.Controls"
    xmlns:lang="clr-namespace:StabilityMatrix.Avalonia.Languages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mocks="clr-namespace:StabilityMatrix.Avalonia.DesignData"
    xmlns:models="clr-namespace:StabilityMatrix.Core.Models;assembly=StabilityMatrix.Core"
    xmlns:sg="clr-namespace:SpacedGridControl.Avalonia;assembly=SpacedGridControl.Avalonia"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:vendorLabs="clr-namespace:StabilityMatrix.Avalonia.Controls.VendorLabs"
    x:Name="Root"
    d:DataContext="{x:Static mocks:DesignData.ModelPickerDialogViewModel}"
    d:DesignHeight="600"
    d:DesignWidth="800"
    x:DataType="dialogs:ModelPickerDialogViewModel"
    mc:Ignorable="d">

    <controls:UserControlBase.Resources>
        <converters:FileUriConverter x:Key="FileUriConverter" />
        <converters:CategoryChipsConverter x:Key="CategoryChipsConverter" />
        <converters:FileExistsConverter x:Key="FileExistsConverter" />
        <converters:FileNotExistsConverter x:Key="FileNotExistsConverter" />
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <converters:EnumStringConverter x:Key="EnumStringConverter" />
        <converters:ModelPickerNsfwOverlayVisibilityConverter x:Key="ModelPickerNsfwOverlayVisibilityConverter" />
        <converters:ObjectEqualsConverter x:Key="ObjectEqualsConverter" />

        <!--  Base model + category chips, the same row the Checkpoint Manager cards use  -->
        <DataTemplate x:Key="ModelChipsTemplate" x:DataType="models:HybridModelFile">
            <WrapPanel Orientation="Horizontal">
                <Border Classes="tag-chip" IsVisible="{Binding Local.ConnectedModelInfo.BaseModel, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}">
                    <TextBlock Text="{Binding Local.ConnectedModelInfo.BaseModel, FallbackValue=''}" />
                </Border>
                <ItemsControl>
                    <ItemsControl.ItemsSource>
                        <MultiBinding Converter="{StaticResource CategoryChipsConverter}">
                            <Binding FallbackValue="{x:Null}" Path="Local.Categories" />
                            <Binding Path="$parent[controls:UserControlBase].((dialogs:ModelPickerDialogViewModel)DataContext).CategoryPalette" />
                        </MultiBinding>
                    </ItemsControl.ItemsSource>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type helpers:CategoryChip}">
                            <Border
                                Background="{Binding Background}"
                                BorderBrush="{Binding Background}"
                                Classes="tag-chip">
                                <TextBlock Foreground="{Binding Foreground}" Text="{Binding Name}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </WrapPanel>
        </DataTemplate>
    </controls:UserControlBase.Resources>

    <controls:UserControlBase.Styles>
        <!--  Wider scrollbar for easier grabbing  -->
        <Style Selector="ListBox ScrollViewer">
            <Style Selector="^ /template/ ScrollBar">
                <Setter Property="Margin" Value="2" />
            </Style>
            <Style Selector="^ /template/ ScrollBar:vertical">
                <Setter Property="Width" Value="14" />
            </Style>
            <Style Selector="^ /template/ ScrollBar:vertical /template/ Thumb">
                <Setter Property="MinWidth" Value="10" />
            </Style>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Border.model-list-card:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="ListBoxItem:selected Border.model-list-card">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Style>
        <!--  Segmented buttons: radio buttons wearing the toggle button theme, so a click never deselects  -->
        <Style Selector="RadioButton.segment">
            <Setter Property="Theme" Value="{DynamicResource {x:Type ToggleButton}}" />
        </Style>
        <Style Selector=":is(ToggleButton).segment">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector=":is(ToggleButton).segment.first">
            <Setter Property="CornerRadius" Value="4,0,0,4" />
        </Style>
        <Style Selector=":is(ToggleButton).segment.middle">
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector=":is(ToggleButton).segment.last">
            <Setter Property="CornerRadius" Value="0,4,4,0" />
        </Style>
        <Style Selector=":is(ToggleButton).segment:checked">
            <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
        </Style>
        <Style Selector=":is(ToggleButton).segment:pointerover:checked">
            <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundPointerOver}" />
        </Style>
        <Style Selector=":is(ToggleButton).segment:pressed:checked">
            <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundPressed}" />
        </Style>

        <!--  Filter dropdowns: no vertical padding, so descenders fit in the fixed 32px height at any scale  -->
        <Style Selector="Button.filter-dropdown">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{DynamicResource ComboBoxBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Border.model-grid-card">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.model-grid-card:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
        </Style>
    </controls:UserControlBase.Styles>

    <sg:SpacedGrid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
        <!--  Title  -->
        <TextBlock
            Margin="0,0,0,4"
            Text="{Binding Title}"
            Theme="{DynamicResource TitleTextBlockStyle}" />

        <!--  Search row: search, NSFW, view mode  -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,Auto,Auto"
            ColumnSpacing="8">
            <TextBox
                x:Name="SearchBox"
                VerticalContentAlignment="Center"
                Text="{Binding SearchText, Mode=TwoWay}"
                Watermark="Search name, base model, tags, categories...">
                <TextBox.InnerLeftContent>
                    <fluentIcons:SymbolIcon
                        Width="16"
                        Height="16"
                        Margin="8,0,4,0"
                        FontSize="16"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Symbol="Search" />
                </TextBox.InnerLeftContent>
            </TextBox>

            <ToggleButton
                Grid.Column="1"
                Height="32"
                Padding="10,0"
                Classes="segment"
                IsChecked="{Binding ShowNsfwContent}"
                ToolTip.Tip="{x:Static lang:Resources.Label_ShowNsfwContent}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <fluentIcons:SymbolIcon
                        Width="14"
                        Height="14"
                        FontSize="14"
                        Symbol="Eye" />
                    <TextBlock Text="{x:Static lang:Resources.Label_NSFW}" />
                </StackPanel>
            </ToggleButton>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <RadioButton
                    Classes="segment first"
                    GroupName="ModelPickerView"
                    IsChecked="{Binding !IsGridView}"
                    ToolTip.Tip="{x:Static lang:Resources.Label_ListView}">
                    <PathIcon
                        Width="14"
                        Height="14"
                        Data="M3 4H7V8H3Z M9 5H21V7H9Z M3 10H7V14H3Z M9 11H21V13H9Z M3 16H7V20H3Z M9 17H21V19H9Z" />
                </RadioButton>
                <RadioButton
                    Classes="segment last"
                    GroupName="ModelPickerView"
                    IsChecked="{Binding IsGridView}"
                    ToolTip.Tip="{x:Static lang:Resources.Label_GridView}">
                    <PathIcon
                        Width="14"
                        Height="14"
                        Data="M4 4H10V10H4Z M14 4H20V10H14Z M4 14H10V20H4Z M14 14H20V20H14Z" />
                </RadioButton>
            </StackPanel>
        </Grid>

        <!--  Filter row: wraps instead of overlapping when the dialog is narrow  -->
        <WrapPanel
            Grid.Row="2"
            ItemSpacing="8"
            LineSpacing="8"
            Orientation="Horizontal">
            <!--  Folder type (only for Checkpoint+UNet source)  -->
            <StackPanel IsVisible="{Binding ShowFolderTypeFilters}" Orientation="Horizontal">
                <RadioButton
                    Classes="segment first"
                    Content="{x:Static lang:Resources.Label_All}"
                    GroupName="ModelPickerFolderType"
                    IsChecked="{Binding ShowAllFolderTypes}" />
                <RadioButton
                    Classes="segment middle"
                    Content="{x:Static lang:Resources.Label_Checkpoints}"
                    GroupName="ModelPickerFolderType"
                    IsChecked="{Binding ShowCheckpointsOnly}" />
                <RadioButton
                    Classes="segment last"
                    Content="{x:Static lang:Resources.Label_DiffusionModels}"
                    GroupName="ModelPickerFolderType"
                    IsChecked="{Binding ShowUnetsOnly}" />
            </StackPanel>

            <!--  Base Model Filter Button  -->
            <Button Classes="filter-dropdown">
                <Button.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding BaseModelButtonText}" />
                        <ui:SymbolIcon
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondary}"
                            Symbol="ChevronDown" />
                    </StackPanel>
                </Button.Content>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                        <StackPanel
                            MaxWidth="400"
                            Orientation="Vertical"
                            Spacing="8">
                            <Button
                                HorizontalAlignment="Stretch"
                                Classes="transparent"
                                Command="{Binding ClearOrSelectAllBaseModelsCommand}"
                                Content="Clear / Select All" />
                            <ui:ItemsRepeater ItemsSource="{Binding BaseModelOptions}">
                                <ui:ItemsRepeater.Layout>
                                    <ui:FlowLayout
                                        LineAlignment="Center"
                                        MinColumnSpacing="4"
                                        MinRowSpacing="4"
                                        Orientation="Horizontal" />
                                </ui:ItemsRepeater.Layout>
                                <ui:ItemsRepeater.ItemTemplate>
                                    <DataTemplate DataType="{x:Type checkpointManager:BaseModelOptionViewModel}">
                                        <ToggleButton Content="{Binding ModelType}" IsChecked="{Binding IsSelected}" />
                                    </DataTemplate>
                                </ui:ItemsRepeater.ItemTemplate>
                            </ui:ItemsRepeater>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!--  Categories Button (only when the source has any)  -->
            <Button Classes="filter-dropdown" IsVisible="{Binding HasCategoryOptions}">
                <Button.Content>
                    <Grid HorizontalAlignment="Stretch" ColumnDefinitions="Auto,6,Auto,8,Auto">
                        <fluentIcons:SymbolIcon
                            Width="14"
                            Height="14"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Symbol="Tag" />
                        <TextBlock Grid.Column="2" Text="{Binding CategoriesButtonText}" />
                        <ui:SymbolIcon
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondary}"
                            Symbol="ChevronDown" />
                    </Grid>
                </Button.Content>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                        <StackPanel
                            MaxWidth="400"
                            Orientation="Vertical"
                            Spacing="8">
                            <Button
                                HorizontalAlignment="Stretch"
                                Classes="transparent"
                                Command="{Binding ClearCategoriesCommand}"
                                Content="{x:Static lang:Resources.Action_ClearSelection}" />
                            <ui:ItemsRepeater ItemsSource="{Binding CategoryOptions}">
                                <ui:ItemsRepeater.Layout>
                                    <ui:FlowLayout
                                        LineAlignment="Center"
                                        MinColumnSpacing="4"
                                        MinRowSpacing="4"
                                        Orientation="Horizontal" />
                                </ui:ItemsRepeater.Layout>
                                <ui:ItemsRepeater.ItemTemplate>
                                    <DataTemplate DataType="{x:Type checkpointManager:CategoryOptionViewModel}">
                                        <ToggleButton IsChecked="{Binding IsSelected}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse
                                                    Width="8"
                                                    Height="8"
                                                    VerticalAlignment="Center"
                                                    Fill="{Binding ColorBrush}" />
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Opacity="0.7"
                                                    Text="{Binding Count}" />
                                            </StackPanel>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ui:ItemsRepeater.ItemTemplate>
                            </ui:ItemsRepeater>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!--  Sort Button  -->
            <Button Classes="filter-dropdown">
                <Button.Content>
                    <Grid HorizontalAlignment="Stretch" ColumnDefinitions="Auto,6,Auto,8,Auto">
                        <fluentIcons:SymbolIcon
                            Width="14"
                            Height="14"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Symbol="ArrowSort" />
                        <TextBlock Grid.Column="2" Text="{x:Static lang:Resources.Label_Sort}" />
                        <ui:SymbolIcon
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondary}"
                            Symbol="ChevronDown" />
                    </Grid>
                </Button.Content>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                        <StackPanel Orientation="Vertical">
                            <ListBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}">
                                <ListBox.Template>
                                    <ControlTemplate>
                                        <ItemsPresenter />
                                    </ControlTemplate>
                                </ListBox.Template>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:CheckpointSortMode}">
                                        <TextBlock Text="{Binding ., Converter={StaticResource EnumStringConverter}}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Separator Margin="8" />
                            <ListBox ItemsSource="{Binding SortDirections}" SelectedItem="{Binding SelectedSortDirection}">
                                <ListBox.Template>
                                    <ControlTemplate>
                                        <ItemsPresenter />
                                    </ControlTemplate>
                                </ListBox.Template>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type componentModel:ListSortDirection}">
                                        <TextBlock Text="{Binding ., Converter={StaticResource EnumStringConverter}}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!--  Clear All Filters  -->
            <Button
                Height="32"
                Padding="10,0"
                Command="{Binding ClearFiltersCommand}"
                IsVisible="{Binding HasActiveFilters}"
                ToolTip.Tip="{x:Static lang:Resources.Label_ClearAllFilters}">
                <fluentIcons:SymbolIcon
                    Width="14"
                    Height="14"
                    FontSize="14"
                    Symbol="Dismiss" />
            </Button>
        </WrapPanel>

        <!--  Model List  -->
        <Border
            Grid.Row="3"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <ListBox
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding FilteredModels}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding SelectedModel}"
                    SelectionMode="Single">
                    <ListBox.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!IsGridView" />
                            <Binding Path="HasFilteredModels" />
                        </MultiBinding>
                    </ListBox.IsVisible>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:HybridModelFile">
                            <Border
                                Margin="2"
                                Padding="8"
                                Background="Transparent"
                                CornerRadius="4"
                                Cursor="Hand">
                                <Border.HorizontalAlignment>Stretch</Border.HorizontalAlignment>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <!--  Thumbnail  -->
                                    <vendorLabs:BetterAsyncImage
                                        x:Name="ListPreviewImage"
                                        Width="56"
                                        Height="56"
                                        CornerRadius="6"
                                        IsVisible="{Binding Local.PreviewImageFullPathGlobal, Converter={StaticResource FileExistsConverter}, FallbackValue=False}"
                                        RenderOptions.BitmapInterpolationMode="HighQuality"
                                        Source="{Binding Local.PreviewImageFullPathGlobal, Converter={StaticResource FileUriConverter}, FallbackValue=''}"
                                        Stretch="UniformToFill" />

                                    <!--  Placeholder when no image  -->
                                    <Border
                                        Width="56"
                                        Height="56"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="6">
                                        <Border.IsVisible>
                                            <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                                <Binding Converter="{StaticResource FileNotExistsConverter}" Path="Local.PreviewImageFullPathGlobal" />
                                                <Binding
                                                    Converter="{StaticResource EnumToBooleanConverter}"
                                                    ConverterParameter="{x:Static labs:AsyncImageState.Failed}"
                                                    ElementName="ListPreviewImage"
                                                    Path="State" />
                                            </MultiBinding>
                                        </Border.IsVisible>
                                        <fluentIcons:SymbolIcon
                                            FontSize="20"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Symbol="Image" />
                                    </Border>
                                    <Border
                                        Width="56"
                                        Height="56"
                                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                        CornerRadius="6">
                                        <Border.IsVisible>
                                            <MultiBinding Converter="{StaticResource ModelPickerNsfwOverlayVisibilityConverter}">
                                                <Binding ElementName="Root" Path="DataContext.ShowNsfwContent" />
                                                <Binding Path="Local.ConnectedModelInfo.Nsfw" />
                                                <Binding Path="Local.PreviewImageFullPathGlobal" />
                                                <Binding ElementName="ListPreviewImage" Path="State" />
                                            </MultiBinding>
                                        </Border.IsVisible>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="NSFW" />
                                    </Border>

                                    <!--  Model Info  -->
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding Local.DisplayModelName, FallbackValue=''}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Local.DisplayModelVersion, FallbackValue=''}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{Binding FileName}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <ContentControl
                                            Margin="0,4,0,-4"
                                            Content="{Binding}"
                                            ContentTemplate="{StaticResource ModelChipsTemplate}" />
                                    </StackPanel>
                                </Grid>

                                <Interaction.Behaviors>
                                    <EventTriggerBehavior EventName="DoubleTapped">
                                        <InvokeCommandAction Command="{Binding $parent[controls:UserControlBase].((dialogs:ModelPickerDialogViewModel)DataContext).SelectModelCommand}" CommandParameter="{Binding}" />
                                    </EventTriggerBehavior>
                                </Interaction.Behaviors>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ScrollViewer HorizontalContentAlignment="Center" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="IsGridView" />
                            <Binding Path="HasFilteredModels" />
                        </MultiBinding>
                    </ScrollViewer.IsVisible>
                    <ItemsRepeater
                        HorizontalAlignment="Center"
                        HorizontalCacheLength="300"
                        ItemsSource="{Binding FilteredModels}"
                        VerticalCacheLength="500">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsJustification="SpaceAround"
                                ItemsStretch="None"
                                MinColumnSpacing="12"
                                MinItemHeight="272"
                                MinItemWidth="188"
                                MinRowSpacing="10" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:HybridModelFile">
                                <Grid Width="188" Height="272">
                                    <Border
                                        Padding="8"
                                        Classes="model-grid-card"
                                        ClipToBounds="True"
                                        CornerRadius="6"
                                        Cursor="Hand">
                                        <Grid RowDefinitions="188,*" RowSpacing="8">
                                            <vendorLabs:BetterAsyncImage
                                                x:Name="GridPreviewImage"
                                                Grid.Row="0"
                                                CornerRadius="6"
                                                IsVisible="{Binding Local.PreviewImageFullPathGlobal, Converter={StaticResource FileExistsConverter}, FallbackValue=False}"
                                                RenderOptions.BitmapInterpolationMode="HighQuality"
                                                Source="{Binding Local.PreviewImageFullPathGlobal, Converter={StaticResource FileUriConverter}, FallbackValue=''}"
                                                Stretch="UniformToFill" />
                                            <Border
                                                Grid.Row="0"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                CornerRadius="6">
                                                <Border.IsVisible>
                                                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                                        <Binding Converter="{StaticResource FileNotExistsConverter}" Path="Local.PreviewImageFullPathGlobal" />
                                                        <Binding
                                                            Converter="{StaticResource EnumToBooleanConverter}"
                                                            ConverterParameter="{x:Static labs:AsyncImageState.Failed}"
                                                            ElementName="GridPreviewImage"
                                                            Path="State" />
                                                    </MultiBinding>
                                                </Border.IsVisible>
                                                <fluentIcons:SymbolIcon
                                                    FontSize="24"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Symbol="Image" />
                                            </Border>
                                            <Border
                                                Grid.Row="0"
                                                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                                CornerRadius="6">
                                                <Border.IsVisible>
                                                    <MultiBinding Converter="{StaticResource ModelPickerNsfwOverlayVisibilityConverter}">
                                                        <Binding ElementName="Root" Path="DataContext.ShowNsfwContent" />
                                                        <Binding Path="Local.ConnectedModelInfo.Nsfw" />
                                                        <Binding Path="Local.PreviewImageFullPathGlobal" />
                                                        <Binding ElementName="GridPreviewImage" Path="State" />
                                                    </MultiBinding>
                                                </Border.IsVisible>
                                                <StackPanel
                                                    Margin="10"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Spacing="4">
                                                    <fluentIcons:SymbolIcon
                                                        HorizontalAlignment="Center"
                                                        FontSize="20"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Symbol="Image" />
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Text="NSFW Hidden" />
                                                    <TextBlock
                                                        MaxWidth="160"
                                                        HorizontalAlignment="Center"
                                                        FontSize="11"
                                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                        MaxLines="2"
                                                        Text="{Binding Local.DisplayModelName, FallbackValue=''}"
                                                        TextAlignment="Center"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                            <!--  Chips over the artwork, like the Checkpoint Manager cards  -->
                                            <ContentControl
                                                Grid.Row="0"
                                                MaxHeight="56"
                                                Margin="6,6,6,0"
                                                VerticalAlignment="Top"
                                                ClipToBounds="True"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource ModelChipsTemplate}" />
                                            <StackPanel Grid.Row="1" Spacing="2">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    MaxLines="2"
                                                    Text="{Binding Local.DisplayModelName, FallbackValue=''}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    MaxLines="1"
                                                    Text="{Binding Local.DisplayModelVersion, FallbackValue=''}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                        </Grid>
                                        <Interaction.Behaviors>
                                            <EventTriggerBehavior EventName="Tapped">
                                                <InvokeCommandAction Command="{Binding $parent[ItemsRepeater].((dialogs:ModelPickerDialogViewModel)DataContext).SetSelectedModelCommand}" CommandParameter="{Binding}" />
                                            </EventTriggerBehavior>
                                            <EventTriggerBehavior EventName="DoubleTapped">
                                                <InvokeCommandAction Command="{Binding $parent[ItemsRepeater].((dialogs:ModelPickerDialogViewModel)DataContext).SelectModelCommand}" CommandParameter="{Binding}" />
                                            </EventTriggerBehavior>
                                        </Interaction.Behaviors>
                                    </Border>
                                    <!--  Selection indicator  -->
                                    <Border
                                        Margin="-1"
                                        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                        BorderThickness="2"
                                        CornerRadius="7"
                                        IsHitTestVisible="False">
                                        <Border.IsVisible>
                                            <MultiBinding Converter="{StaticResource ObjectEqualsConverter}">
                                                <Binding />
                                                <Binding ElementName="Root" Path="DataContext.SelectedModel" />
                                            </MultiBinding>
                                        </Border.IsVisible>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

                <StackPanel
                    Margin="0,18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding !HasFilteredModels}"
                    Spacing="10">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="No models match your filters" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Try a broader search, or clear your filters."
                        TextAlignment="Center" />
                    <Button
                        HorizontalAlignment="Center"
                        Command="{Binding ClearFiltersCommand}"
                        Content="Clear Filters"
                        IsVisible="{Binding HasActiveFilters}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Footer  -->
        <sg:SpacedGrid
            Grid.Row="4"
            ColumnDefinitions="*,Auto,Auto,Auto"
            ColumnSpacing="8">
            <StackPanel Spacing="2">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding FilteredModels.Count, StringFormat='{}{0} models'}" />
                <TextBlock
                    FontSize="11"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="Tips: Double-click or Enter to select, Ctrl+F to search, Esc to close." />
            </StackPanel>

            <Button
                Grid.Column="2"
                MinWidth="80"
                Command="{Binding OnCloseButtonClick}"
                Content="Cancel" />

            <Button
                Grid.Column="3"
                MinWidth="80"
                Classes="accent"
                Command="{Binding SelectModelCommand}"
                CommandParameter="{Binding SelectedModel}"
                Content="Select"
                IsEnabled="{Binding SelectedModel, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </sg:SpacedGrid>
    </sg:SpacedGrid>
</controls:UserControlBase>
