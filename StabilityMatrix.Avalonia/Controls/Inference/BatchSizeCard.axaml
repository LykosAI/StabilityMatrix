<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StabilityMatrix.Avalonia.Controls"
    xmlns:converters="clr-namespace:StabilityMatrix.Avalonia.Converters"
    xmlns:icons="clr-namespace:Projektanker.Icons.Avalonia;assembly=Projektanker.Icons.Avalonia"
    xmlns:lang="clr-namespace:StabilityMatrix.Avalonia.Languages"
    xmlns:mocks="clr-namespace:StabilityMatrix.Avalonia.DesignData"
    xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    xmlns:vmInference="using:StabilityMatrix.Avalonia.ViewModels.Inference"
    x:DataType="vmInference:BatchSizeCardViewModel">

    <Design.PreviewWith>
        <StackPanel Spacing="8">
            <controls:BatchSizeCard DataContext="{x:Static mocks:DesignData.BatchSizeCardViewModel}" />
            <controls:BatchSizeCard Width="280" DataContext="{x:Static mocks:DesignData.BatchSizeCardViewModelWithIndexOption}" />
        </StackPanel>
    </Design.PreviewWith>

    <Style Selector="controls|BatchSizeCard">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="ContextFlyout">
            <ui:FAMenuFlyout Placement="BottomEdgeAlignedLeft">
                <ui:ToggleMenuFlyoutItem IsChecked="{Binding IsBatchIndexEnabled}" Text="{x:Static lang:Resources.Label_BatchIndex}" />
            </ui:FAMenuFlyout>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <controls:Card Padding="8">
                    <Grid
                        Margin="8"
                        ColumnDefinitions="*,*"
                        RowDefinitions="Auto,Auto">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Text="{x:Static lang:Resources.Label_BatchSize}" />
                                <icons:Icon FontSize="12" Value="fa-solid fa-table-cells-large" />
                            </StackPanel>
                            <NumericUpDown
                                MinWidth="120"
                                Margin="0,4,4,0"
                                HorizontalAlignment="Stretch"
                                ClipValueToMinMax="True"
                                Increment="1"
                                Minimum="1"
                                ParsingNumberStyle="Integer"
                                Value="{Binding BatchSize, Converter={x:Static converters:NullableDefaultNumericConverters.IntToDecimal}}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="4,0,8,0"
                                    VerticalAlignment="Center"
                                    Text="{x:Static lang:Resources.Label_Batches}" />
                                <icons:Icon FontSize="14" Value="fa-regular fa-images" />
                            </StackPanel>
                            <NumericUpDown
                                MinWidth="120"
                                Margin="4,4,0,0"
                                HorizontalAlignment="Stretch"
                                ClipValueToMinMax="True"
                                Increment="1"
                                Minimum="1"
                                ParsingNumberStyle="Integer"
                                Value="{Binding BatchCount, Converter={x:Static converters:NullableDefaultNumericConverters.IntToDecimal}}" />
                        </StackPanel>

                        <!--  Optional index selection  -->
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="0,8,0,0"
                            IsVisible="{Binding IsBatchIndexEnabled}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Text="{x:Static lang:Resources.Label_BatchIndex}" />
                                <icons:Icon FontSize="12" Value="fa-solid fa-crosshairs" />
                            </StackPanel>
                            <NumericUpDown
                                MinWidth="120"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Stretch"
                                ClipValueToMinMax="True"
                                Increment="1"
                                Maximum="{Binding BatchSize}"
                                Minimum="1"
                                ParsingNumberStyle="Integer"
                                Value="{Binding BatchIndex, Converter={x:Static converters:NullableDefaultNumericConverters.IntToDecimal}}" />
                        </StackPanel>

                    </Grid>
                </controls:Card>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
