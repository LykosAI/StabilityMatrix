<UserControl
    x:Class="StabilityMatrix.Avalonia.Views.Dialogs.OneClickInstallDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:StabilityMatrix.Avalonia.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:designData="clr-namespace:StabilityMatrix.Avalonia.DesignData"
    xmlns:dialogs="clr-namespace:StabilityMatrix.Avalonia.ViewModels.Dialogs"
    xmlns:lang="clr-namespace:StabilityMatrix.Avalonia.Languages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:StabilityMatrix.Core.Models;assembly=StabilityMatrix.Core"
    xmlns:packages="clr-namespace:StabilityMatrix.Core.Models.Packages;assembly=StabilityMatrix.Core"
    xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    d:DataContext="{x:Static designData:DesignData.OneClickInstallViewModel}"
    d:DesignHeight="700"
    d:DesignWidth="700"
    x:DataType="dialogs:OneClickInstallViewModel"
    mc:Ignorable="d">

    <Grid
        MaxHeight="900"
        ColumnDefinitions="*,Auto"
        RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">

        <Grid.Transitions>
            <Transitions>
                <DoubleTransition
                    Easing="0,0 0,1"
                    Property="Width"
                    Duration="00:00:00.25" />
                <DoubleTransition
                    Easing="0,0 0,1"
                    Property="Height"
                    Duration="00:00:00.25" />
            </Transitions>
        </Grid.Transitions>

        <ui:TeachingTip
            Name="InferenceTeachingTip"
            Title="Use ComfyUI with Inference"
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            MinWidth="100"
            Margin="8,0,0,0"
            ActionButtonCommand="{Binding InstallComfyForInferenceCommand}"
            ActionButtonContent="{x:Static lang:Resources.Action_Install}"
            CloseButtonContent="{x:Static lang:Resources.Action_Close}"
            PlacementMargin="0,0,0,0"
            PreferredPlacement="RightTop"
            Subtitle="A new built-in native Stable Diffusion experience, powered by ComfyUI"
            TailVisibility="Auto">
            <ui:TeachingTip.HeroContent>
                <controls:BetterAdvancedImage RenderOptions.BitmapInterpolationMode="HighQuality" Source="https://cdn.lykos.ai/static/sc-inference-drag-load.gif" />
            </ui:TeachingTip.HeroContent>
        </ui:TeachingTip>

        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2">
            <TextBlock
                Margin="8,0,8,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="36"
                FontWeight="Light"
                Text="{Binding HeaderText, FallbackValue=Installing Stable Diffusion WebUI...}"
                TextWrapping="Wrap" />
            <TextBlock
                Margin="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                FontSize="16"
                FontWeight="Light"
                Text="{Binding SubHeaderText, FallbackValue=Installing git...}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Separator
                Margin="16,4"
                Background="#AAAAAA"
                IsVisible="{Binding ShowInstallButton}" />
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Grid.Column="0"
            IsVisible="{Binding ShowInstallButton}">
            <TextBlock
                Margin="16,16,0,4"
                FontSize="24"
                Text="{Binding SelectedPackage.DisplayName}" />
            <TextBlock
                Margin="16,0,0,4"
                Text="{Binding SelectedPackage.Blurb}"
                TextWrapping="Wrap" />
            <TextBlock
                Margin="16,0,0,0"
                Foreground="OrangeRed"
                IsVisible="{Binding SelectedPackage.Disclaimer, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Text="{Binding SelectedPackage.Disclaimer}"
                TextWrapping="Wrap" />
            <ItemsRepeater Margin="16,0,0,0" ItemsSource="{Binding SelectedPackage.AvailableTorchIndices}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:TorchIndex}">
                        <controls:Card
                            Margin="0,8,8,0"
                            Padding="4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Tag="{Binding}">

                            <controls:Card.Styles>
                                <Style Selector="controls|Card[Tag=Cuda]">
                                    <Setter Property="Background" Value="{DynamicResource ThemeGreenColorTransparent}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeGreenColorTransparent}" />
                                    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
                                    </Style>
                                    <Setter Property="Content">
                                        <Template>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontWeight="Medium"
                                                Text="NVIDIA"
                                                TextAlignment="Center" />
                                        </Template>
                                    </Setter>
                                </Style>
                                <Style Selector="controls|Card[Tag=Rocm]">
                                    <Setter Property="Background" Value="{DynamicResource ThemeDarkRedColor}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeDarkRedColor}" />
                                    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
                                    </Style>
                                    <Setter Property="Content">
                                        <Template>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontWeight="Medium"
                                                Text="AMD (Linux)"
                                                TextAlignment="Center"
                                                ToolTip.Tip="For AMD GPUs that support ROCm on Linux" />
                                        </Template>
                                    </Setter>
                                </Style>
                                <Style Selector="controls|Card[Tag=DirectMl]">
                                    <Setter Property="Background" Value="{DynamicResource ThemeDarkBlueColor}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeDarkBlueColor}" />
                                    <Setter Property="Content">
                                        <Template>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontWeight="Medium"
                                                Text="DirectML"
                                                TextAlignment="Center"
                                                ToolTip.Tip="For any DirectX compatible GPU on Windows" />
                                        </Template>
                                    </Setter>
                                </Style>
                                <Style Selector="controls|Card[Tag=Mps]">
                                    <Setter Property="Background" Value="White" />
                                    <Setter Property="BorderBrush" Value="White" />
                                    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
                                    </Style>
                                    <Setter Property="Content">
                                        <Template>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontWeight="Medium"
                                                Foreground="Black"
                                                Text="macOS"
                                                TextAlignment="Center" />
                                        </Template>
                                    </Setter>
                                </Style>
                                <Style Selector="controls|Card[Tag=Zluda]">
                                    <Setter Property="Background" Value="{DynamicResource ThemeDarkDarkRedColor}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeDarkDarkRedColor}" />
                                    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
                                    </Style>
                                    <Setter Property="Content">
                                        <Template>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontWeight="Medium"
                                                Text="ZLUDA"
                                                TextAlignment="Center"
                                                ToolTip.Tip="For AMD GPUs that support ZLUDA" />
                                        </Template>
                                    </Setter>
                                </Style>
                                <Style Selector="controls|Card[Tag=Cpu]">
                                    <Setter Property="Background" Value="{DynamicResource ThemeBlueGreyColor}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBlueGreyColor}" />
                                    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Foreground" Value="{DynamicResource ButtonForeground}" />
                                    </Style>
                                    <Setter Property="Content">
                                        <Template>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontWeight="Medium"
                                                Text="CPU"
                                                TextAlignment="Center" />
                                        </Template>
                                    </Setter>
                                </Style>
                            </controls:Card.Styles>
                        </controls:Card>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <controls:BetterAdvancedImage
                Width="400"
                Height="300"
                Margin="16,8"
                HorizontalAlignment="Left"
                Source="{Binding SelectedPackage.PreviewImageUri}"
                Stretch="UniformToFill" />
        </StackPanel>

        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            Margin="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            FontSize="10"
            Text="{Binding SubSubHeaderText, FallbackValue=Installing git...}"
            TextAlignment="Center"
            TextWrapping="Wrap" />

        <ProgressBar
            Grid.Row="3"
            Grid.Column="0"
            Margin="16"
            VerticalAlignment="Center"
            IsIndeterminate="{Binding IsIndeterminate}"
            IsVisible="{Binding IsProgressBarVisible}"
            Maximum="100"
            Value="{Binding OneClickInstallProgress}">
            <ProgressBar.Transitions>
                <Transitions>
                    <DoubleTransition Property="Value" Duration="00:00:00.150">
                        <DoubleTransition.Easing>
                            <SineEaseInOut />
                        </DoubleTransition.Easing>
                    </DoubleTransition>
                </Transitions>
            </ProgressBar.Transitions>
        </ProgressBar>

        <StackPanel
            Grid.Row="4"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Center"
            IsVisible="{Binding ShowInstallButton}"
            Orientation="Vertical">
            <Button
                Margin="8"
                Padding="16,8,16,8"
                HorizontalAlignment="Center"
                Classes="success"
                Command="{Binding InstallCommand}"
                Content="{x:Static lang:Resources.Action_Install}"
                FontSize="32" />
            <Button
                Padding="16,8,16,8"
                HorizontalAlignment="Center"
                Command="{Binding ToggleAdvancedModeCommand}"
                Content="{x:Static lang:Resources.Label_SkipSetup}"
                FontSize="16" />
        </StackPanel>

        <CheckBox
            Grid.Row="2"
            Grid.Column="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Content="Show All Packages"
            IsChecked="{Binding ShowIncompatiblePackages}"
            IsVisible="{Binding ShowInstallButton}"
            ToolTip.Tip="Enabling &quot;Show All Packages&quot; will include packages that may not be compatible with your system and may run very slowly as a result." />


        <ScrollViewer
            Grid.Row="1"
            Grid.Column="1"
            MaxHeight="400"
            Margin="0,8"
            VerticalScrollBarVisibility="Visible">
            <ListBox
                Name="PackagesListBox"
                Margin="8,0"
                IsVisible="{Binding ShowInstallButton}"
                ItemsSource="{Binding AllPackages}"
                SelectedItem="{Binding SelectedPackage}">
                <ListBox.Template>
                    <ControlTemplate>
                        <ItemsPresenter />
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type packages:BasePackage}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Margin="8">
                                <TextBlock Text="{Binding DisplayName}" />
                                <TextBlock Text="{Binding ByAuthor}" />
                            </StackPanel>
                            <ui:InfoBadge
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Classes="Success Dot"
                                IsVisible="{Binding IsInferenceCompatible}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
    </Grid>

</UserControl>
