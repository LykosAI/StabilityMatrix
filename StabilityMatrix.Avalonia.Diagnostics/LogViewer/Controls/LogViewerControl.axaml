<UserControl
    x:Class="StabilityMatrix.Avalonia.Diagnostics.LogViewer.Controls.LogViewerControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:StabilityMatrix.Avalonia.Diagnostics.LogViewer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:logging="clr-namespace:StabilityMatrix.Avalonia.Diagnostics.LogViewer.Core.Logging"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:CompileBindings="True"
    x:DataType="logging:ILogDataStoreImpl"
    mc:Ignorable="d">

    <Grid RowDefinitions="*,Auto">
        <Grid.Resources>
            <converters:ChangeColorTypeConverter x:Key="ColorConverter" />
            <converters:EventIdConverter x:Key="EventIdConverter" />
            <SolidColorBrush x:Key="ColorBlack">Black</SolidColorBrush>
            <SolidColorBrush x:Key="ColorTransparent">Transparent</SolidColorBrush>
        </Grid.Resources>
        <Grid.Styles>
            <Style Selector="DataGridRow">
                <Setter Property="Padding" Value="0" />
                <Setter x:DataType="logging:LogModel" Property="Foreground" Value="{Binding Color.Foreground, FallbackValue=White, Converter={StaticResource ColorConverter}, ConverterParameter={StaticResource ColorBlack}}" />
                <Setter x:DataType="logging:LogModel" Property="Background" Value="{Binding Color.Background, FallbackValue=Black, Converter={StaticResource ColorConverter}, ConverterParameter={StaticResource ColorTransparent}}" />
            </Style>
            <Style Selector="DataGridCell.size">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="0" />
            </Style>
        </Grid.Styles>
        <DataGrid
            x:Name="MyDataGrid"
            AutoGenerateColumns="False"
            CanUserReorderColumns="True"
            CanUserResizeColumns="True"
            CanUserSortColumns="False"
            ItemsSource="{Binding DataStore.Entries}"
            LayoutUpdated="OnLayoutUpdated">

            <DataGrid.Styles>
                <Style Selector="TextBlock">
                    <Setter Property="TextWrapping" Value="WrapWithOverflow" />
                </Style>
            </DataGrid.Styles>

            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding Timestamp}"
                    CellStyleClasses="size"
                    Header="Time"
                    IsVisible="{Binding #IsTimestampVisible.IsChecked}" />
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding LogLevel}"
                    CellStyleClasses="size"
                    Header="Level" />
                <!--<DataGridTextColumn CellStyleClasses="size" Header="Event Id" Width="120" Binding="{Binding EventId, Converter={StaticResource EventIdConverter}}" />-->
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding LoggerDisplayName}"
                    CellStyleClasses="size"
                    Header="Callsite" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding State}"
                    CellStyleClasses="size"
                    Header="State" />
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding Exception}"
                    CellStyleClasses="size"
                    Header="Exception" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel
            Grid.Row="1"
            Margin="20,10"
            Orientation="Horizontal">
            <CheckBox
                x:Name="CanAutoScroll"
                Content="Auto Scroll log"
                FontSize="11"
                IsChecked="True" />
            <CheckBox
                x:Name="IsTimestampVisible"
                Content="Show Timestamp"
                FontSize="11" />
        </StackPanel>


    </Grid>

</UserControl>
