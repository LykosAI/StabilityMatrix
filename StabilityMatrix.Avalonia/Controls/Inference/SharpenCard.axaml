<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StabilityMatrix.Avalonia.Controls"
    xmlns:inference="clr-namespace:StabilityMatrix.Avalonia.ViewModels.Inference"
    xmlns:lang="clr-namespace:StabilityMatrix.Avalonia.Languages"
    xmlns:mocks="clr-namespace:StabilityMatrix.Avalonia.DesignData"
    xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    x:DataType="inference:SharpenCardViewModel">
    <Design.PreviewWith>
        <Grid Width="600" Height="400">
            <StackPanel>
                <controls:SharpenCard DataContext="{x:Static mocks:DesignData.SharpenCardViewModel}" />
            </StackPanel>
        </Grid>
    </Design.PreviewWith>

    <Style Selector="controls|SharpenCard">
        <!--  Set Defaults  -->
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <ControlTemplate>
                <controls:Card x:Name="PART_Card">
                    <StackPanel Spacing="8">
                        <!--  Sharpen Radius  -->
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock VerticalAlignment="Center" Text="Sharpen Radius" />
                                <ui:NumberBox
                                    Grid.Column="1"
                                    MinWidth="70"
                                    Margin="4,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    Maximum="31"
                                    Minimum="1"
                                    SimpleNumberFormat="F0"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact"
                                    ValidationMode="InvalidInputOverwritten"
                                    Value="{Binding SharpenRadius}" />
                            </Grid>
                            <Slider
                                Margin="0,0,0,-4"
                                Maximum="31"
                                Minimum="1"
                                TickFrequency="1"
                                TickPlacement="BottomRight"
                                Value="{Binding SharpenRadius}" />
                        </StackPanel>

                        <!--  Sigma  -->
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock VerticalAlignment="Center" Text="Sigma" />
                                <ui:NumberBox
                                    Grid.Column="1"
                                    MinWidth="70"
                                    Margin="4,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    Maximum="10"
                                    Minimum="0.1"
                                    SimpleNumberFormat="F1"
                                    SmallChange="0.1"
                                    SpinButtonPlacementMode="Compact"
                                    ValidationMode="InvalidInputOverwritten"
                                    Value="{Binding Sigma}" />
                            </Grid>
                            <Slider
                                Margin="0,0,0,-4"
                                Maximum="10"
                                Minimum="0.1"
                                SmallChange="0.1"
                                TickPlacement="BottomRight"
                                Value="{Binding Sigma}" />
                        </StackPanel>

                        <!--  Alpha  -->
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock VerticalAlignment="Center" Text="Alpha" />
                                <ui:NumberBox
                                    Grid.Column="1"
                                    MinWidth="70"
                                    Margin="4,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    Maximum="5"
                                    Minimum="0"
                                    SimpleNumberFormat="F1"
                                    SmallChange="0.1"
                                    SpinButtonPlacementMode="Compact"
                                    ValidationMode="InvalidInputOverwritten"
                                    Value="{Binding Alpha}" />
                            </Grid>
                            <Slider
                                Margin="0,0,0,-4"
                                IsSnapToTickEnabled="True"
                                Maximum="5"
                                Minimum="0"
                                SmallChange="0.1"
                                TickFrequency="0.5"
                                TickPlacement="BottomRight"
                                Value="{Binding Alpha}" />
                        </StackPanel>
                    </StackPanel>
                </controls:Card>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
