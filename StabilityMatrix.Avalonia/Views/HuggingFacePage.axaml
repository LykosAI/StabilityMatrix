<controls:UserControlBase
    x:Class="StabilityMatrix.Avalonia.Views.HuggingFacePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="https://github.com/projektanker/icons.avalonia"
    xmlns:checkpointBrowser="clr-namespace:StabilityMatrix.Avalonia.ViewModels.CheckpointBrowser"
    xmlns:controls="clr-namespace:StabilityMatrix.Avalonia.Controls"
    xmlns:converters="clr-namespace:StabilityMatrix.Avalonia.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:StabilityMatrix.Avalonia.Helpers"
    xmlns:huggingFace="clr-namespace:StabilityMatrix.Core.Models.Api.HuggingFace;assembly=StabilityMatrix.Core"
    xmlns:huggingFacePage="clr-namespace:StabilityMatrix.Avalonia.ViewModels.HuggingFacePage"
    xmlns:lang="clr-namespace:StabilityMatrix.Avalonia.Languages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mocks="clr-namespace:StabilityMatrix.Avalonia.DesignData"
    xmlns:models="clr-namespace:StabilityMatrix.Core.Models;assembly=StabilityMatrix.Core"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    d:DataContext="{x:Static mocks:DesignData.HuggingFacePageViewModel}"
    d:DesignHeight="650"
    d:DesignWidth="800"
    x:CompileBindings="True"
    x:DataType="checkpointBrowser:HuggingFacePageViewModel"
    Focusable="True"
    mc:Ignorable="d">
    <controls:UserControlBase.Resources>
        <converters:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
    </controls:UserControlBase.Resources>
    <Grid
        Margin="8"
        HorizontalAlignment="Stretch"
        RowDefinitions="Auto,Auto,Auto,*">

        <!--  Search bar  -->
        <Grid
            Grid.Row="0"
            Margin="0,0,0,4"
            ColumnDefinitions="*,Auto">
            <TextBox
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="{Binding SearchQuery}"
                Watermark="{x:Static lang:Resources.Label_HuggingFaceSearchWatermark}">
                <TextBox.InnerLeftContent>
                    <avalonia:Icon Margin="8,0,0,0" Value="fa-solid fa-magnifying-glass" />
                </TextBox.InnerLeftContent>
                <TextBox.InnerRightContent>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Button
                            Margin="0,0,4,0"
                            Padding="4"
                            VerticalAlignment="Center"
                            BorderThickness="0"
                            Classes="transparent"
                            Command="{Binding ClearSearchCommand}"
                            IsVisible="{Binding !!SearchQuery}">
                            <ui:SymbolIcon Symbol="Cancel" />
                        </Button>
                    </StackPanel>
                </TextBox.InnerRightContent>
            </TextBox>
            <ComboBox
                Grid.Column="1"
                MinWidth="160"
                Margin="8,0,0,0"
                VerticalAlignment="Stretch"
                VerticalContentAlignment="Center"
                IsVisible="{Binding IsSearchResultsVisible}"
                ItemsSource="{Binding SearchSortOptions}"
                SelectedItem="{Binding SearchSort}"
                ToolTip.Tip="{x:Static lang:Resources.Label_SortResults}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="huggingFace:HuggingFaceSearchSort">
                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <ui:CommandBar
            Grid.Row="1"
            Margin="0,-1,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            VerticalContentAlignment="Center"
            DefaultLabelPosition="Right">
            <ui:CommandBar.PrimaryCommands>
                <ui:CommandBarButton
                    Command="{Binding ImportSelectedCommand}"
                    Foreground="{DynamicResource AccentButtonBackground}"
                    IconSource="Download"
                    IsEnabled="{Binding !!NumSelected}"
                    Label="{x:Static lang:Resources.Action_Import}" />
                <ui:CommandBarSeparator />
                <ui:CommandBarButton
                    Command="{Binding Refresh}"
                    IconSource="Refresh"
                    Label="{x:Static lang:Resources.Action_Refresh}" />
                <ui:CommandBarButton
                    Command="{Binding SelectAll}"
                    IconSource="SelectAll"
                    Label="{x:Static lang:Resources.Action_SelectAll}" />
                <ui:CommandBarButton
                    Command="{Binding ClearSelection}"
                    IconSource="ClearSelection"
                    IsEnabled="{Binding !!NumSelected}"
                    Label="{x:Static lang:Resources.Action_ClearSelection}" />
                <ui:CommandBarSeparator IsVisible="{Binding !!NumSelected}" />
            </ui:CommandBar.PrimaryCommands>
        </ui:CommandBar>

        <!--  Curated (default / empty search)  -->
        <ScrollViewer Grid.Row="3" IsVisible="{Binding IsCuratedVisible}">
            <ItemsRepeater ItemsSource="{Binding Categories}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate DataType="{x:Type huggingFacePage:CategoryViewModel}">
                        <Expander Margin="0,0,0,8" IsExpanded="True">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox Content="{Binding Title}" IsChecked="{Binding IsChecked}" />
                                </StackPanel>
                            </Expander.Header>
                            <ItemsRepeater Margin="8,0" ItemsSource="{Binding Items}">
                                <ItemsRepeater.Layout>
                                    <WrapLayout
                                        HorizontalSpacing="8"
                                        Orientation="Horizontal"
                                        VerticalSpacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate DataType="{x:Type huggingFacePage:HuggingfaceItemViewModel}">
                                        <Button
                                            MinWidth="300"
                                            MaxWidth="300"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{Binding ToggleSelectedCommand}"
                                            CornerRadius="8"
                                            IsEnabled="{Binding !Exists}">
                                            <Button.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuItem
                                                        Command="{x:Static helpers:IOCommands.OpenUrlCommand}"
                                                        CommandParameter="{Binding RepoUrl}"
                                                        Header="{x:Static lang:Resources.Action_OpenOnHuggingFace}">
                                                        <MenuItem.Icon>
                                                            <ui:SymbolIcon Symbol="Open" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem
                                                        Command="{x:Static helpers:IOCommands.OpenUrlCommand}"
                                                        CommandParameter="{Binding LicenseUrl}"
                                                        Header="{x:Static lang:Resources.Label_License}">
                                                        <MenuItem.Icon>
                                                            <ui:SymbolIcon Symbol="Document" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </MenuFlyout>
                                            </Button.ContextFlyout>
                                            <Grid ColumnDefinitions="*, Auto, Auto">
                                                <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsSelected}">
                                                    <TextBlock
                                                        MaxWidth="225"
                                                        Text="{Binding Item.ModelName}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="NoWrap"
                                                        ToolTip.Tip="{Binding Item.ModelName}" />
                                                </CheckBox>
                                                <avalonia:Icon
                                                    Grid.Column="1"
                                                    Margin="0,0,4,0"
                                                    IsVisible="{Binding Item.LoginRequired}"
                                                    ToolTip.Tip="{x:Static lang:Resources.Label_LoginRequired}"
                                                    Value="fa-solid fa-lock" />
                                                <Button
                                                    Grid.Column="2"
                                                    Width="24"
                                                    Margin="0,4,4,0"
                                                    Padding="4"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    HorizontalContentAlignment="Right"
                                                    VerticalContentAlignment="Top"
                                                    BorderThickness="0"
                                                    Classes="transparent"
                                                    IsEnabled="{Binding !Exists}">
                                                    <ui:SymbolIcon FontSize="18" Symbol="MoreVertical" />
                                                    <Button.Flyout>
                                                        <MenuFlyout>
                                                            <MenuItem
                                                                Command="{x:Static helpers:IOCommands.OpenUrlCommand}"
                                                                CommandParameter="{Binding RepoUrl}"
                                                                Header="{x:Static lang:Resources.Action_OpenOnHuggingFace}">
                                                                <MenuItem.Icon>
                                                                    <ui:SymbolIcon Symbol="Open" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem
                                                                Command="{x:Static helpers:IOCommands.OpenUrlCommand}"
                                                                CommandParameter="{Binding LicenseUrl}"
                                                                Header="{x:Static lang:Resources.Label_License}">
                                                                <MenuItem.Icon>
                                                                    <ui:SymbolIcon Symbol="List" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Expander>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!--  Live search results  -->
        <ScrollViewer
            Grid.Row="3"
            IsVisible="{Binding IsSearchResultsVisible}"
            ScrollChanged="SearchResults_OnScrollChanged">
            <StackPanel Orientation="Vertical">
                <TextBlock
                    Margin="4,8"
                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                    IsVisible="{Binding !!ErrorMessage}"
                    Text="{Binding ErrorMessage}"
                    TextWrapping="Wrap" />
                <ItemsRepeater Margin="0,0,14,0" ItemsSource="{Binding SearchResults}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsJustification="Center"
                            MinColumnSpacing="14"
                            MinItemHeight="158"
                            MinItemWidth="248"
                            MinRowSpacing="14"
                            Orientation="Horizontal" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate DataType="{x:Type huggingFacePage:HuggingFaceSearchResultViewModel}">
                            <Button
                                Width="248"
                                Height="158"
                                Padding="12"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Command="{Binding SelectCommand}"
                                CornerRadius="10">
                                <Button.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuItem
                                            Command="{x:Static helpers:IOCommands.OpenUrlCommand}"
                                            CommandParameter="{Binding RepoUrl}"
                                            Header="{x:Static lang:Resources.Action_OpenOnHuggingFace}">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Open" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </MenuFlyout>
                                </Button.ContextFlyout>
                                <Grid RowDefinitions="Auto,*,Auto,Auto">
                                    <!--  Pipeline tag chip  -->
                                    <Border
                                        Grid.Row="0"
                                        Padding="6,1"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="4"
                                        IsVisible="{Binding HasPipelineTag}">
                                        <TextBlock
                                            FontSize="11"
                                            Opacity="0.85"
                                            Text="{Binding PipelineTag}" />
                                    </Border>

                                    <!--  Author + model name  -->
                                    <StackPanel
                                        Grid.Row="1"
                                        Margin="0,8,0,0"
                                        VerticalAlignment="Top"
                                        Orientation="Vertical">
                                        <TextBlock
                                            FontSize="11"
                                            IsVisible="{Binding HasAuthor}"
                                            Opacity="0.6"
                                            Text="{Binding Author}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            MaxLines="2"
                                            Text="{Binding ModelName}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap"
                                            ToolTip.Tip="{Binding Id}" />
                                    </StackPanel>

                                    <!--  Tags  -->
                                    <TextBlock
                                        Grid.Row="2"
                                        Margin="0,6,0,0"
                                        FontSize="11"
                                        Opacity="0.5"
                                        Text="{Binding TagsText}"
                                        TextTrimming="CharacterEllipsis" />

                                    <!--  Stats footer  -->
                                    <Grid
                                        Grid.Row="3"
                                        Margin="0,8,0,0"
                                        ColumnDefinitions="Auto,Auto,*">
                                        <StackPanel
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="4"
                                            ToolTip.Tip="{x:Static lang:Resources.Label_Downloads}">
                                            <avalonia:Icon
                                                FontSize="11"
                                                Opacity="0.7"
                                                Value="fa-solid fa-download" />
                                            <TextBlock
                                                FontSize="12"
                                                Opacity="0.85"
                                                Text="{Binding DownloadsText}" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="4"
                                            ToolTip.Tip="{x:Static lang:Resources.Label_Likes}">
                                            <avalonia:Icon
                                                FontSize="11"
                                                Opacity="0.7"
                                                Value="fa-solid fa-heart" />
                                            <TextBlock
                                                FontSize="12"
                                                Opacity="0.85"
                                                Text="{Binding LikesText}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Opacity="0.45"
                                            Text="{Binding LastUpdatedText}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!--  Infinite-scroll loading-more spinner + end-of-results marker  -->
                <controls:ProgressRing
                    Width="28"
                    Height="28"
                    Margin="0,12"
                    HorizontalAlignment="Center"
                    IsIndeterminate="True"
                    IsVisible="{Binding IsLoadingMore}" />
                <TextBlock
                    Margin="0,8,0,12"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    IsVisible="{Binding ShowEndOfResults}"
                    Opacity="0.5"
                    Text="{x:Static lang:Resources.Label_EndOfResults}" />
            </StackPanel>
        </ScrollViewer>

        <!--  Repo file tree  -->
        <Grid
            Grid.Row="3"
            IsVisible="{Binding IsRepoFilesVisible}"
            RowDefinitions="Auto,Auto,Auto,*">
            <Grid
                Grid.Row="0"
                Margin="2,0,2,8"
                ColumnDefinitions="*,Auto">
                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="6">
                    <avalonia:Icon VerticalAlignment="Center" Value="fa-solid fa-folder-tree" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{Binding CurrentRepoId}" />
                    <Button
                        Padding="4"
                        VerticalAlignment="Center"
                        Classes="transparent"
                        Command="{x:Static helpers:IOCommands.OpenUrlCommand}"
                        CommandParameter="{Binding CurrentRepoId, StringFormat='https://huggingface.co/{0}'}"
                        ToolTip.Tip="{x:Static lang:Resources.Action_OpenOnHuggingFace}">
                        <ui:SymbolIcon Symbol="Open" />
                    </Button>
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">
                    <CheckBox
                        VerticalAlignment="Center"
                        Content="{x:Static lang:Resources.Label_HideInstalled}"
                        IsChecked="{Binding HideInstalled}" />
                    <ToggleSwitch
                        MinWidth="0"
                        VerticalAlignment="Center"
                        IsChecked="{Binding IsStructuredView}"
                        ToolTip.Tip="{x:Static lang:Resources.Label_ToggleFlatOrTree}">
                        <ToggleSwitch.Resources>
                            <!--  No header here, so drop the reserved header margin that offsets the knob downward.  -->
                            <Thickness x:Key="ToggleSwitchTopHeaderMargin">0</Thickness>
                        </ToggleSwitch.Resources>
                        <ToggleSwitch.OffContent>
                            <avalonia:Icon VerticalAlignment="Center" Value="fa-solid fa-list" />
                        </ToggleSwitch.OffContent>
                        <ToggleSwitch.OnContent>
                            <avalonia:Icon VerticalAlignment="Center" Value="fa-solid fa-folder-tree" />
                        </ToggleSwitch.OnContent>
                    </ToggleSwitch>
                </StackPanel>
            </Grid>

            <TextBox
                Grid.Row="1"
                Margin="0,0,0,8"
                VerticalAlignment="Center"
                Text="{Binding RepoFilter}"
                Watermark="{x:Static lang:Resources.Label_FilterFilesByName}">
                <TextBox.InnerLeftContent>
                    <avalonia:Icon
                        Margin="8,0,0,0"
                        Opacity="0.6"
                        Value="fa-solid fa-filter" />
                </TextBox.InnerLeftContent>
            </TextBox>

            <TextBlock
                Grid.Row="2"
                Margin="4,8"
                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                IsVisible="{Binding !!ErrorMessage}"
                Text="{Binding ErrorMessage}"
                TextWrapping="Wrap" />

            <!--  Flat list  -->
            <ScrollViewer Grid.Row="3" IsVisible="{Binding !IsStructuredView}">
                <ItemsRepeater Margin="0,0,14,0" ItemsSource="{Binding RepoFiles}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="2" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate DataType="{x:Type huggingFacePage:HuggingFaceFileViewModel}">
                            <Border
                                Padding="8,4"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <CheckBox
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding IsSelected}"
                                        IsEnabled="{Binding !Exists}">
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock
                                                Text="{Binding Path}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip.Tip="{Binding Path}" />
                                            <TextBlock
                                                FontSize="11"
                                                Opacity="0.6"
                                                Text="{Binding SizeText}" />
                                        </StackPanel>
                                    </CheckBox>
                                    <ComboBox
                                        Grid.Column="1"
                                        MinWidth="170"
                                        Margin="8,0"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding !Exists}"
                                        ItemsSource="{Binding AvailableFolders}"
                                        SelectedItem="{Binding SelectedFolder}"
                                        ToolTip.Tip="{x:Static lang:Resources.Label_DestinationFolder}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:SharedFolderType">
                                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="8,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding Exists}"
                                        Orientation="Horizontal"
                                        Spacing="5"
                                        ToolTip.Tip="{Binding SelectedFolder, Converter={StaticResource EnumDescriptionConverter}, StringFormat={x:Static lang:Resources.Label_InstalledInFolder}}">
                                        <avalonia:Icon
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                            Value="fa-solid fa-circle-check" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Opacity="0.7"
                                            Text="{x:Static lang:Resources.Label_Installed}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!--  Structured folder tree  -->
            <TreeView
                Grid.Row="3"
                Margin="0,0,8,0"
                IsVisible="{Binding IsStructuredView}"
                ItemsSource="{Binding RepoTreeRoot}">
                <TreeView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </TreeView.ItemsPanel>
                <TreeView.Styles>
                    <Style x:DataType="huggingFacePage:HuggingFaceTreeNodeViewModel" Selector="TreeViewItem">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                    <!--
                        Selection is meaningless here (checkboxes drive actions), so make a selected
                        row look identical to a normal one. These mirror FluentAvalonia's own :selected
                        selectors (TreeViewStyles.axaml) and win by being applied after the control theme.
                    -->
                    <Style Selector="TreeViewItem:selected /template/ Rectangle#SelectionIndicator">
                        <Setter Property="IsVisible" Value="False" />
                    </Style>
                    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                    </Style>
                    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot:pointerover">
                        <Setter Property="Background" Value="{DynamicResource TreeViewItemBackgroundPointerOver}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource TreeViewItemBorderBrushPointerOver}" />
                    </Style>
                </TreeView.Styles>
                <TreeView.ItemTemplate>
                    <TreeDataTemplate DataType="{x:Type huggingFacePage:HuggingFaceTreeNodeViewModel}" ItemsSource="{Binding Children}">
                        <Grid
                            Height="36"
                            Margin="0,1,18,1"
                            ColumnDefinitions="*,Auto">
                            <!--  Folder row (chevron or double-click to expand)  -->
                            <StackPanel
                                Grid.Column="0"
                                IsVisible="{Binding IsFolder}"
                                Orientation="Horizontal"
                                Spacing="6">
                                <CheckBox
                                    MinWidth="0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding IsChecked}"
                                    ToolTip.Tip="{x:Static lang:Resources.Label_SelectAllFilesInFolder}" />
                                <avalonia:Icon VerticalAlignment="Center" Value="fa-solid fa-folder" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{Binding Name}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Opacity="0.5"
                                    Text="{Binding FolderSummary}" />
                            </StackPanel>

                            <!--  File row  -->
                            <CheckBox
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                IsChecked="{Binding File.IsSelected}"
                                IsEnabled="{Binding !File.Exists}"
                                IsVisible="{Binding !IsFolder}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <avalonia:Icon
                                        VerticalAlignment="Center"
                                        Opacity="0.6"
                                        Value="fa-regular fa-file" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Opacity="0.5"
                                        Text="{Binding File.SizeText}" />
                                </StackPanel>
                            </CheckBox>
                            <ComboBox
                                Grid.Column="1"
                                MinWidth="170"
                                Margin="8,0"
                                VerticalAlignment="Center"
                                IsVisible="{Binding !File.Exists, FallbackValue=False}"
                                ItemsSource="{Binding File.AvailableFolders}"
                                SelectedItem="{Binding File.SelectedFolder}"
                                ToolTip.Tip="{x:Static lang:Resources.Label_DestinationFolder}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:SharedFolderType">
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <StackPanel
                                Grid.Column="1"
                                Margin="8,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                IsVisible="{Binding File.Exists, FallbackValue=False, TargetNullValue=False}"
                                Orientation="Horizontal"
                                Spacing="5"
                                ToolTip.Tip="{Binding File.SelectedFolder, Converter={StaticResource EnumDescriptionConverter}, StringFormat={x:Static lang:Resources.Label_InstalledInFolder}}">
                                <avalonia:Icon
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                    Value="fa-solid fa-circle-check" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Opacity="0.7"
                                    Text="{x:Static lang:Resources.Label_Installed}" />
                            </StackPanel>
                        </Grid>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>

        <controls:ProgressRing
            Grid.Row="3"
            Width="96"
            Height="96"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsIndeterminate="True"
            IsVisible="{Binding IsLoading}" />

        <ui:InfoBar
            Title="{Binding SelectionSummary}"
            Grid.Row="3"
            Margin="0,0,8,8"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            HorizontalContentAlignment="Right"
            Background="#AA000000"
            CloseButtonCommand="{Binding ClearSelection}"
            CornerRadius="8"
            IsIconVisible="False"
            IsOpen="{Binding !!NumSelected}">
            <ui:InfoBar.ActionButton>
                <StackPanel Orientation="Vertical" Spacing="6">
                    <StackPanel
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="6">
                        <!--  Bulk-set destination for all selected files (repo files only)  -->
                        <ComboBox
                            MinWidth="150"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsRepoFilesVisible}"
                            ItemsSource="{Binding BulkDestinationOptions}"
                            PlaceholderText="{x:Static lang:Resources.Label_SetDestination}"
                            SelectedItem="{Binding BulkDestination}"
                            ToolTip.Tip="{x:Static lang:Resources.Label_SetDestinationTooltip}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="checkpointBrowser:BulkDestinationOption">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!--  Structure-preserving "import to folder" (repo files only)  -->
                        <Button
                            x:Name="ImportToFolderButton"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsRepoFilesVisible}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <avalonia:Icon VerticalAlignment="Center" Value="fa-solid fa-folder-plus" />
                                <TextBlock Text="{x:Static lang:Resources.Action_ImportToFolder}" />
                                <ui:SymbolIcon FontSize="12" Symbol="ChevronDown" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="Top">
                                    <StackPanel Width="320" Spacing="8">
                                        <TextBlock
                                            Opacity="0.8"
                                            Text="{x:Static lang:Resources.Label_ImportToFolderDescription}"
                                            TextWrapping="Wrap" />
                                        <StackPanel
                                            IsVisible="{Binding IsMultiFileModel}"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <avalonia:Icon
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                Value="fa-solid fa-circle-info" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Text="{Binding MultiFileHint}" />
                                        </StackPanel>

                                        <!--  Type + subfolder  -->
                                        <StackPanel IsVisible="{Binding !HasCustomFolderPath}" Spacing="6">
                                            <TextBlock
                                                FontSize="12"
                                                Opacity="0.7"
                                                Text="{x:Static lang:Resources.Label_Folder}" />
                                            <ComboBox
                                                HorizontalAlignment="Stretch"
                                                ItemsSource="{Binding SelectableFolders}"
                                                SelectedItem="{Binding FolderImportType}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="models:SharedFolderType">
                                                        <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock
                                                FontSize="12"
                                                Opacity="0.7"
                                                Text="{x:Static lang:Resources.Label_Subfolder}" />
                                            <TextBox Text="{Binding FolderImportSubfolder}" Watermark="{x:Static lang:Resources.Label_RepoNameWatermark}" />
                                        </StackPanel>

                                        <!--  Custom folder (from Browse)  -->
                                        <StackPanel IsVisible="{Binding HasCustomFolderPath}" Spacing="4">
                                            <TextBlock
                                                FontSize="12"
                                                Opacity="0.7"
                                                Text="{x:Static lang:Resources.Label_CustomFolder}" />
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Text="{Binding FolderImportCustomPath}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip.Tip="{Binding FolderImportCustomPath}" />
                                                <Button
                                                    Grid.Column="1"
                                                    Padding="4"
                                                    Classes="transparent"
                                                    Command="{Binding ClearCustomFolderCommand}"
                                                    ToolTip.Tip="{x:Static lang:Resources.Action_ClearCustomFolder}">
                                                    <ui:SymbolIcon Symbol="Cancel" />
                                                </Button>
                                            </Grid>
                                        </StackPanel>

                                        <Button
                                            HorizontalAlignment="Left"
                                            Click="BrowseFolder_OnClick"
                                            Content="{x:Static lang:Resources.Action_Browse}" />
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Classes="accent"
                                            Command="{Binding ImportSelectedToFolderCommand}"
                                            Content="{x:Static lang:Resources.Action_ImportToFolder}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button
                            VerticalAlignment="Center"
                            Classes="accent"
                            Command="{Binding ImportSelectedCommand}"
                            Content="{x:Static lang:Resources.Action_Import}" />
                    </StackPanel>
                    <StackPanel
                        MaxWidth="320"
                        HorizontalAlignment="Right"
                        IsVisible="{Binding !!DiskSpaceWarning}"
                        Orientation="Horizontal"
                        Spacing="5">
                        <avalonia:Icon
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                            Value="fa-solid fa-triangle-exclamation" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                            Text="{Binding DiskSpaceWarning}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ui:InfoBar.ActionButton>
        </ui:InfoBar>
    </Grid>
</controls:UserControlBase>
