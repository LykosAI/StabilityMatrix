<controls:UserControlBase
    x:Class="StabilityMatrix.Avalonia.Views.Inference.InferenceTextToVideoView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:StabilityMatrix.Avalonia.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:inference="clr-namespace:StabilityMatrix.Avalonia.ViewModels.Inference"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mocks="clr-namespace:StabilityMatrix.Avalonia.DesignData"
    d:DataContext="{x:Static mocks:DesignData.InferenceTextToVideoViewModel}"
    d:DesignHeight="750"
    d:DesignWidth="1100"
    x:DataType="inference:InferenceTextToVideoViewModel"
    mc:Ignorable="d">
    <Grid Margin="2,0,2,8">
        <DockControl
            x:Name="Dock"
            InitializeFactory="True"
            InitializeLayout="True">
            <DockControl.Factory>
                <Factory />
            </DockControl.Factory>

            <RootDock
                x:Name="Root"
                DefaultDockable="{Binding #MainLayout}"
                Id="Root"
                IsCollapsable="False">

                <ProportionalDock
                    x:Name="MainLayout"
                    Id="MainLayout"
                    Orientation="Horizontal">

                    <!--  Left Pane  -->
                    <ToolDock
                        x:Name="ConfigPane"
                        Alignment="Left"
                        Id="ConfigPane"
                        Proportion="0.2">
                        <Tool
                            x:Name="ConfigTool"
                            Title="Config"
                            x:DataType="Tool"
                            CanClose="False"
                            Id="ConfigTool">
                            <controls:StackCard DataContext="{ReflectionBinding ElementName=Dock, Path=DataContext.StackCardViewModel}" Opacity="1" />
                        </Tool>
                    </ToolDock>

                    <ProportionalDockSplitter x:Name="Splitter1" Id="Splitter1" />

                    <!--  Prompt Pane  -->
                    <ProportionalDock
                        x:Name="CenterProportionalDock"
                        Id="CenterProportionalDock"
                        Orientation="Vertical">

                        <ToolDock
                            x:Name="PromptPane"
                            Alignment="Left"
                            Id="PromptPane"
                            Proportion="0.9">
                            <Tool
                                x:Name="PromptTool"
                                Title="Prompt"
                                x:DataType="Tool"
                                CanClose="False"
                                Id="PromptTool">

                                <!--  Prompt  -->
                                <Grid
                                    x:CompileBindings="False"
                                    DataContext="{Binding ElementName=Dock, Path=DataContext}"
                                    Opacity="1"
                                    RowDefinitions="*">
                                    <!--  Prompt card  -->
                                    <controls:PromptCard DataContext="{Binding PromptCardViewModel}" />
                                </Grid>

                            </Tool>
                        </ToolDock>

                        <!--  Generate Dock  -->
                        <ToolDock
                            x:Name="GeneratePane"
                            Alignment="Left"
                            Id="GeneratePane"
                            Proportion="0.1">
                            <Tool
                                x:Name="GenerateTool"
                                Title="Generate"
                                x:DataType="Tool"
                                CanClose="False"
                                Id="GenerateTool">
                                <!--  Generate Buttons  -->

                                <controls:GenerateButtonBar
                                    Margin="0,6,0,0"
                                    x:CompileBindings="False"
                                    DataContext="{Binding ElementName=Dock, Path=DataContext}"
                                    ShowCurrentSeedButton="True"
                                    ShowHiresFixButton="True" />
                            </Tool>
                        </ToolDock>

                    </ProportionalDock>


                    <ProportionalDockSplitter x:Name="Splitter2" Id="Splitter2" />

                    <!--  Middle Right Pane  -->
                    <ToolDock
                        x:Name="ImageGalleryPane"
                        Alignment="Right"
                        Id="ImageGalleryPane"
                        Proportion="0.35">
                        <Tool
                            x:Name="ImageGalleryTool"
                            Title="Image Output"
                            x:DataType="Tool"
                            CanClose="False"
                            Id="ImageGalleryTool">

                            <Grid x:CompileBindings="False" DataContext="{Binding ElementName=Dock, Path=DataContext}">
                                <controls:ImageGalleryCard Grid.Row="0" DataContext="{Binding ImageGalleryCardViewModel}" />

                                <StackPanel
                                    Margin="2,1,2,4"
                                    VerticalAlignment="Top"
                                    DataContext="{Binding OutputProgress}"
                                    Spacing="4">
                                    <ProgressBar
                                        IsIndeterminate="{Binding IsIndeterminate}"
                                        IsVisible="{Binding IsProgressVisible}"
                                        Maximum="{Binding Maximum}"
                                        Value="{Binding Value}" />

                                    <TextBlock
                                        Margin="0,10,0,0"
                                        IsVisible="{Binding IsTextVisible}"
                                        Text="{Binding Text}"
                                        TextAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Tool>
                    </ToolDock>

                    <ProportionalDockSplitter x:Name="Splitter3" Id="Splitter3" />

                    <!--  Right Pane  -->
                    <ToolDock
                        x:Name="ImageFolderPane"
                        Alignment="Right"
                        Id="ImageFolderPane"
                        Proportion="0.1">
                        <Tool
                            x:Name="ImageFolderTool"
                            Title="Gallery"
                            x:DataType="Tool"
                            CanClose="False"
                            Id="ImageFolderTool">

                            <Grid x:CompileBindings="False" DataContext="{Binding ElementName=Dock, Path=DataContext}">
                                <controls:ImageFolderCard DataContext="{Binding ImageFolderCardViewModel}" />
                            </Grid>
                        </Tool>
                    </ToolDock>

                </ProportionalDock>
            </RootDock>

        </DockControl>
    </Grid>
</controls:UserControlBase>
