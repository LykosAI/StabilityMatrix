<controls:UserControlBase
    x:Class="StabilityMatrix.Avalonia.Views.Dialogs.ModelCategoriesDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:StabilityMatrix.Avalonia.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:StabilityMatrix.Avalonia.ViewModels.Dialogs"
    xmlns:lang="clr-namespace:StabilityMatrix.Avalonia.Languages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    d:DesignHeight="480"
    d:DesignWidth="440"
    x:DataType="dialogs:ModelCategoriesDialogViewModel"
    mc:Ignorable="d">

    <StackPanel MinWidth="380" Spacing="12">
        <TextBlock
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            IsVisible="{Binding HasTargets}"
            Text="{Binding TargetsDescription}"
            TextTrimming="CharacterEllipsis" />

        <TextBlock
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            IsVisible="{Binding !HasRows}"
            Text="{x:Static lang:Resources.Label_NoCategoriesHint}"
            TextWrapping="Wrap" />

        <ScrollViewer MaxHeight="380" IsVisible="{Binding HasRows}">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type dialogs:ModelCategoryRowViewModel}">
                        <Grid
                            Margin="0,2"
                            ColumnDefinitions="Auto,Auto,*,Auto"
                            ColumnSpacing="10">
                            <CheckBox
                                Grid.Column="0"
                                MinWidth="0"
                                Padding="0"
                                VerticalAlignment="Center"
                                IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                IsThreeState="True"
                                IsVisible="{Binding $parent[ItemsControl].((dialogs:ModelCategoriesDialogViewModel)DataContext).HasTargets}" />
                            <ui:ColorPickerButton
                                Grid.Column="1"
                                Width="36"
                                Height="28"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{x:Static lang:Resources.Label_Color}"
                                Color="{Binding Color, Mode=TwoWay}" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding Count}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox
                Grid.Column="0"
                Text="{Binding NewCategoryName, Mode=TwoWay}"
                Watermark="{x:Static lang:Resources.Label_NewCategory}">
                <TextBox.KeyBindings>
                    <KeyBinding Command="{Binding AddCategoryCommand}" Gesture="Enter" />
                </TextBox.KeyBindings>
            </TextBox>
            <Button
                Grid.Column="1"
                Classes="accent"
                Command="{Binding AddCategoryCommand}"
                Content="{x:Static lang:Resources.Action_Add}" />
        </Grid>
    </StackPanel>
</controls:UserControlBase>
