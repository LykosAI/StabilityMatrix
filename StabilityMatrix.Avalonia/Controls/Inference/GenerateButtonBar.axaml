<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StabilityMatrix.Avalonia.Controls"
    xmlns:fluentIcons="using:FluentIcons.Avalonia.Fluent"
    xmlns:icons="clr-namespace:Projektanker.Icons.Avalonia;assembly=Projektanker.Icons.Avalonia"
    xmlns:lang="clr-namespace:StabilityMatrix.Avalonia.Languages"
    xmlns:markupExtensions="clr-namespace:StabilityMatrix.Avalonia.MarkupExtensions"
    xmlns:mocks="clr-namespace:StabilityMatrix.Avalonia.DesignData"
    xmlns:modelsInference="clr-namespace:StabilityMatrix.Avalonia.Models.Inference"
    xmlns:vmBase="clr-namespace:StabilityMatrix.Avalonia.ViewModels.Base"
    x:CompileBindings="True"
    x:DataType="vmBase:InferenceGenerationViewModelBase">

    <Design.PreviewWith>
        <StackPanel Width="500" Spacing="8">
            <controls:GenerateButtonBar
                DataContext="{x:Static mocks:DesignData.InferenceTextToImageViewModel}"
                ShowCurrentSeedButton="True"
                ShowHiresFixButton="True" />
            <controls:GenerateButtonBar DataContext="{x:Static mocks:DesignData.InferenceTextToImageViewModel}" PillMaxWidth="320" />
        </StackPanel>
    </Design.PreviewWith>

    <Style Selector="controls|GenerateButtonBar">
        <Setter Property="Template">
            <ControlTemplate>
                <controls:Card Padding="8">
                    <!--  Recessed pill wrapping the generate button row  -->
                    <Border
                        MaxWidth="{TemplateBinding PillMaxWidth}"
                        Padding="6,4"
                        HorizontalAlignment="Stretch"
                        Background="#33000000"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <!--  Star flanks keep the generate button centered whatever they hold  -->
                        <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,*">
                            <Grid.Styles>
                                <Style Selector="Button">
                                    <Setter Property="MinHeight" Value="32" />
                                </Style>
                                <!--  Borderless icon buttons; hover highlight preserved  -->
                                <Style Selector="Button.transparent">
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                                <!--
                                    Disabled flank buttons keep the pill's surface. The shared
                                    transparent style fills them with the same brush it uses for
                                    hover, which inside the pill reads as "hovered", not "disabled".
                                -->
                                <Style Selector="Button.transparent:disabled /template/ ContentPresenter#PART_ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                </Style>
                            </Grid.Styles>

                            <!--  Left flank: hires, then divider hugging Generate's left edge  -->
                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="0"
                                HorizontalAlignment="Right"
                                IsVisible="{TemplateBinding ShowHiresFixButton}"
                                Orientation="Horizontal">
                                <Button
                                    Margin="4,0"
                                    Padding="12,8"
                                    icons:Attached.Icon="fa-solid fa-magnifying-glass-plus"
                                    Classes="transparent"
                                    Command="{Binding GenerateImageCommand}"
                                    CommandParameter="{x:Static modelsInference:GenerateFlags.HiresFixAndUseCurrentSeed}"
                                    ToolTip.Tip="Generate with Hires Scaling" />
                                <Border
                                    Width="1"
                                    Height="22"
                                    Margin="4,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                            </StackPanel>

                            <!--  Center: Generate + Cancel overlay  -->
                            <Panel Grid.Row="1" Grid.Column="1">
                                <Button
                                    x:Name="GenerateButton"
                                    Width="130"
                                    HorizontalAlignment="Stretch"
                                    Classes="accent"
                                    Command="{Binding GenerateImageCommand}"
                                    CommandParameter="{x:Static modelsInference:GenerateFlags.None}"
                                    HotKey="{markupExtensions:PlatformGesture Ctrl+Enter}"
                                    IsVisible="{Binding !GenerateImageCommand.CanBeCanceled}"
                                    ToolTip.Tip="{Binding $self.HotKey}">
                                    <Panel>
                                        <TextBlock IsVisible="{Binding #GenerateButton.IsEnabled}" Text="Generate Image" />
                                        <controls:ProgressRing IsIndeterminate="True" IsVisible="{Binding !#GenerateButton.IsEnabled}" />
                                    </Panel>
                                </Button>
                                <Button
                                    x:Name="CancelButton"
                                    Width="130"
                                    HorizontalAlignment="Stretch"
                                    icons:Attached.Icon="fa-solid fa-stop"
                                    Command="{Binding GenerateImageCancelCommand}"
                                    IsVisible="{Binding GenerateImageCommand.CanBeCanceled}" />
                            </Panel>

                            <!--  Right flank: divider, current-seed, then add-to-queue  -->
                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="2"
                                HorizontalAlignment="Left"
                                Orientation="Horizontal">
                                <Border
                                    Width="1"
                                    Height="22"
                                    Margin="4,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                <Button
                                    Margin="4,0"
                                    Padding="12,8"
                                    icons:Attached.Icon="fa-solid fa-repeat"
                                    Classes="transparent"
                                    Command="{Binding GenerateImageCommand}"
                                    CommandParameter="{x:Static modelsInference:GenerateFlags.UseCurrentSeed}"
                                    IsVisible="{TemplateBinding ShowCurrentSeedButton}"
                                    ToolTip.Tip="Generate with current seed" />
                                <Button
                                    Margin="4,0"
                                    Padding="12,8"
                                    VerticalAlignment="Center"
                                    Classes="transparent"
                                    Command="{Binding AddToQueueCommand}"
                                    ToolTip.Tip="{x:Static lang:Resources.Label_AddToQueue}">
                                    <fluentIcons:SymbolIcon
                                        Width="16"
                                        Height="16"
                                        FontSize="16"
                                        Symbol="AppsAddIn" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </controls:Card>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
