<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StabilityMatrix.Avalonia.Controls"
    xmlns:converters="clr-namespace:StabilityMatrix.Avalonia.Converters"
    xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
    xmlns:inference="clr-namespace:StabilityMatrix.Avalonia.ViewModels.Inference"
    xmlns:lang="clr-namespace:StabilityMatrix.Avalonia.Languages"
    xmlns:mocks="clr-namespace:StabilityMatrix.Avalonia.DesignData"
    xmlns:sg="clr-namespace:SpacedGridControl.Avalonia;assembly=SpacedGridControl.Avalonia"
    xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    x:DataType="inference:WanModelCardViewModel">
    <Design.PreviewWith>
        <Panel Width="400" Height="400">
            <controls:WanModelCard DataContext="{x:Static mocks:DesignData.WanModelCardViewModel}" />
        </Panel>
    </Design.PreviewWith>

    <Styles.Resources>
        <fluent:SymbolIconSource
            x:Key="IconCube"
            IconVariant="Filled"
            Symbol="Cube" />
        <fluent:SymbolIconSource
            x:Key="IconQuestionCircle"
            IconVariant="Filled"
            Symbol="QuestionCircle" />
        <fluent:SymbolIconSource
            x:Key="IconTableCellEdit"
            IconVariant="Filled"
            Symbol="TableCellEdit" />
    </Styles.Resources>

    <Style Selector="controls|WanModelCard">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <controls:Card Padding="12">
                    <sg:SpacedGrid
                        ColumnDefinitions="90,*,Auto"
                        ColumnSpacing="4"
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                        RowSpacing="0">
                        <!--  Model  -->
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="{x:Static lang:Resources.Label_Model}"
                            TextAlignment="Left" />

                        <controls:BetterComboBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Padding="8,6,4,6"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding ClientManager.UnetModels}"
                            SelectedItem="{Binding SelectedModel}"
                            Theme="{StaticResource BetterComboBoxHybridModelTheme}" />

                        <!--  Browse + Settings  -->
                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="2"
                            VerticalAlignment="Stretch"
                            Orientation="Horizontal"
                            Spacing="4">
                            <Button
                                VerticalAlignment="Stretch"
                                Command="{Binding OpenModelPickerCommand}"
                                ToolTip.Tip="Browse all models">
                                <fluent:SymbolIcon FontSize="16" Symbol="Search" />
                            </Button>
                            <Button VerticalAlignment="Stretch" ToolTip.Tip="Model options">
                                <ui:SymbolIcon FontSize="16" Symbol="Setting" />
                                <Button.Flyout>
                                    <ui:FAMenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <ui:ToggleMenuFlyoutItem
                                            IconSource="{StaticResource IconCube}"
                                            IsChecked="{Binding IsLowNoiseModelEnabled}"
                                            Text="Low Noise Model" />
                                    </ui:FAMenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>

                        <!--  model precision  -->
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,8,0,0"
                            VerticalAlignment="Center"
                            Text="Precision"
                            TextAlignment="Left"
                            ToolTip.Tip="Weight precision the model loads at. fp8 variants use much less VRAM with a small quality tradeoff; 'default' loads at full precision." />

                        <ui:FAComboBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            IsTextSearchEnabled="True"
                            ItemsSource="{Binding WeightDTypes}"
                            SelectedItem="{Binding SelectedDType}" />

                        <!--  VAE  -->
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,8,0,0"
                            VerticalAlignment="Center"
                            Text="{x:Static lang:Resources.Label_VAE}"
                            TextAlignment="Left"
                            ToolTip.Tip="Decodes the generated latents into the final video frames. Use the VAE that matches your model (e.g. the Wan VAE)." />

                        <ui:FAComboBox
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            DisplayMemberBinding="{Binding ShortDisplayName}"
                            IsTextSearchEnabled="True"
                            ItemsSource="{Binding ClientManager.VaeModels}"
                            SelectedItem="{Binding SelectedVae}" />
                        <Button
                            Grid.Row="2"
                            Grid.Column="2"
                            Margin="0,8,0,0"
                            VerticalAlignment="Stretch"
                            Command="{Binding OpenVaePickerCommand}"
                            ToolTip.Tip="Browse all VAE models">
                            <fluent:SymbolIcon FontSize="16" Symbol="Search" />
                        </Button>

                        <!--  Text Encoder  -->
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Margin="0,8,0,0"
                            VerticalAlignment="Center"
                            Text="Text Encoder"
                            TextAlignment="Left"
                            ToolTip.Tip="Turns your prompt text into conditioning the model understands (the Wan UMT5 text encoder)." />

                        <controls:BetterDownloadableComboBox
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="0,8,0,0"
                            Padding="8,6,4,6"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding ClientManager.ClipModels}"
                            SelectedItem="{Binding SelectedClipModel}"
                            Theme="{StaticResource BetterComboBoxHybridModelTheme}" />
                        <Button
                            Grid.Row="3"
                            Grid.Column="2"
                            Margin="0,8,0,0"
                            VerticalAlignment="Stretch"
                            Command="{Binding OpenClipPickerCommand}"
                            ToolTip.Tip="Browse all CLIP models">
                            <fluent:SymbolIcon FontSize="16" Symbol="Search" />
                        </Button>

                        <!--  CLIP Vision  -->
                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="0"
                            Margin="0,8,0,0"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsClipVisionEnabled}"
                            Text="CLIP Vision"
                            TextAlignment="Left" />

                        <controls:BetterDownloadableComboBox
                            Grid.Row="4"
                            Grid.Column="1"
                            Margin="0,8,0,0"
                            Padding="8,6,4,6"
                            HorizontalAlignment="Stretch"
                            IsVisible="{Binding IsClipVisionEnabled}"
                            ItemsSource="{Binding ClientManager.ClipVisionModels}"
                            SelectedItem="{Binding SelectedClipVisionModel}"
                            Theme="{StaticResource BetterComboBoxHybridModelTheme}" />
                        <Button
                            Grid.Row="4"
                            Grid.Column="2"
                            Margin="0,8,0,0"
                            VerticalAlignment="Stretch"
                            Command="{Binding OpenClipVisionPickerCommand}"
                            IsVisible="{Binding IsClipVisionEnabled}"
                            ToolTip.Tip="Browse all CLIP Vision models">
                            <fluent:SymbolIcon FontSize="16" Symbol="Search" />
                        </Button>

                        <!--  Shift  -->
                        <TextBlock
                            Grid.Row="5"
                            Grid.Column="0"
                            Margin="0,8,0,0"
                            VerticalAlignment="Center"
                            Text="Shift"
                            ToolTip.Tip="Shifts the noise schedule (ModelSamplingSD3). Higher values spend more sampling on the high-noise (motion/structure) stage. 8.0 is the Wan default." />
                        <ui:NumberBox
                            Grid.Row="5"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            SelectionHighlightColor="Transparent"
                            SimpleNumberFormat="F2"
                            SmallChange="0.25"
                            SpinButtonPlacementMode="Inline"
                            Value="{Binding Shift}" />

                        <!--  Low-noise model (Wan 2.2 14B MoE, toggled from the model options menu)  -->
                        <TextBlock
                            Grid.Row="6"
                            Grid.Column="0"
                            Margin="0,8,0,0"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsLowNoiseModelEnabled}"
                            Text="Low-Noise"
                            TextAlignment="Left"
                            ToolTip.Tip="Optional second Wan 2.2 14B expert that refines the high-noise pass. Leave empty to generate with a single model." />
                        <controls:BetterComboBox
                            Grid.Row="6"
                            Grid.Column="1"
                            Margin="0,8,0,0"
                            Padding="8,6,4,6"
                            HorizontalAlignment="Stretch"
                            IsVisible="{Binding IsLowNoiseModelEnabled}"
                            ItemsSource="{Binding ClientManager.UnetModels}"
                            SelectedItem="{Binding SelectedLowNoiseModel}"
                            Theme="{StaticResource BetterComboBoxHybridModelTheme}" />
                        <Button
                            Grid.Row="6"
                            Grid.Column="2"
                            Margin="0,8,0,0"
                            VerticalAlignment="Stretch"
                            Command="{Binding OpenLowNoiseModelPickerCommand}"
                            IsVisible="{Binding IsLowNoiseModelEnabled}"
                            ToolTip.Tip="Browse all models">
                            <fluent:SymbolIcon FontSize="16" Symbol="Search" />
                        </Button>

                        <!--  MoE boundary  -->
                        <TextBlock
                            Grid.Row="7"
                            Grid.Column="0"
                            Margin="0,8,0,0"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsLowNoiseModelEnabled}"
                            Text="Boundary"
                            ToolTip.Tip="Fraction of sampling steps run by the high-noise expert before handing off to the low-noise expert. 0.5 splits the steps evenly." />
                        <ui:NumberBox
                            Grid.Row="7"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            IsVisible="{Binding IsLowNoiseModelEnabled}"
                            Maximum="1"
                            Minimum="0"
                            SelectionHighlightColor="Transparent"
                            SimpleNumberFormat="F2"
                            SmallChange="0.05"
                            SpinButtonPlacementMode="Inline"
                            ToolTip.Tip="Fraction of steps run by the high-noise expert before switching to the low-noise expert."
                            Value="{Binding MoeBoundary}" />

                        <!--  Extra Networks (high-noise / primary model)  -->
                        <Panel
                            Grid.Row="8"
                            Grid.Column="0"
                            Grid.ColumnSpan="3">
                            <controls:StackEditableCard Margin="0,8,0,0" DataContext="{Binding ExtraNetworksStackCardViewModel}" />
                        </Panel>

                        <!--  Low-Noise LoRAs (low-noise expert, Wan 2.2 14B)  -->
                        <Panel
                            Grid.Row="9"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            IsVisible="{Binding IsLowNoiseModelEnabled}">
                            <controls:StackEditableCard Margin="0,8,0,0" DataContext="{Binding LowNoiseExtraNetworksStackCardViewModel}" />
                        </Panel>
                    </sg:SpacedGrid>
                </controls:Card>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>