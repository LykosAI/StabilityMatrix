<UserControl
    x:Class="StabilityMatrix.Avalonia.Controls.VideoPlayerView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:StabilityMatrix.Avalonia.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fluent="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
    xmlns:gif="clr-namespace:Avalonia.Gif;assembly=Avalonia.Gif"
    xmlns:lang="clr-namespace:StabilityMatrix.Avalonia.Languages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:StabilityMatrix.Avalonia.Models"
    xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="models:ImageSource"
    mc:Ignorable="d">
    <!--  Transparent background so the whole area (not just drawn frames) takes the context flyout  -->
    <Grid Background="Transparent" ClipToBounds="True">
        <Grid.ContextFlyout>
            <ui:FAMenuFlyout>
                <ui:MenuFlyoutItem
                    Command="{x:Static controls:VideoPlayerView.OpenExternalCommand}"
                    CommandParameter="{Binding}"
                    IconSource="Open"
                    Text="{x:Static lang:Resources.Action_OpenInExternalPlayer}" />
                <ui:MenuFlyoutItem
                    Command="{x:Static controls:VideoPlayerView.CopyFileCommand}"
                    CommandParameter="{Binding}"
                    IconSource="Copy"
                    Text="{x:Static lang:Resources.Action_Copy}" />
            </ui:FAMenuFlyout>
        </Grid.ContextFlyout>

        <gif:VideoImage
            x:Name="Player"
            Source="{Binding LocalFile.FullPath}"
            Stretch="Uniform" />

        <!--  Opening the clip takes a moment (ffmpeg probe + first frame)  -->
        <controls:ProgressRing
            Width="48"
            Height="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsIndeterminate="True">
            <controls:ProgressRing.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="!#Player.IsPlaying" />
                    <Binding Path="!#Player.HasLoadFailed" />
                </MultiBinding>
            </controls:ProgressRing.IsVisible>
        </controls:ProgressRing>

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsVisible="{Binding #Player.HasLoadFailed}"
            Spacing="12">
            <fluent:SymbolIcon
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                FontSize="48"
                Symbol="VideoClip" />
            <TextBlock
                HorizontalAlignment="Center"
                Opacity="0.8"
                Text="{x:Static lang:Resources.Label_VideoDecodeFailed}" />
            <Button
                HorizontalAlignment="Center"
                Command="{x:Static controls:VideoPlayerView.OpenExternalCommand}"
                CommandParameter="{Binding}"
                Content="{x:Static lang:Resources.Action_OpenInExternalPlayer}" />
        </StackPanel>

        <!--  In-app playback is silent; this is the way to the audio  -->
        <Button
            Margin="8"
            Padding="10,6"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="#99000000"
            Classes="transparent"
            Command="{x:Static controls:VideoPlayerView.OpenExternalCommand}"
            CommandParameter="{Binding}"
            CornerRadius="16"
            IsVisible="{Binding #Player.IsPlaying}"
            ToolTip.Tip="{x:Static lang:Resources.Label_VideoPreviewMuted}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <fluent:SymbolIcon
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Symbol="SpeakerMute" />
                <TextBlock VerticalAlignment="Center" Text="{x:Static lang:Resources.Action_OpenInExternalPlayer}" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
