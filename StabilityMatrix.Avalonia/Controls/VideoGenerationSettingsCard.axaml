<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StabilityMatrix.Avalonia.Controls"
    xmlns:controls1="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    xmlns:lang="clr-namespace:StabilityMatrix.Avalonia.Languages"
    xmlns:mocks="clr-namespace:StabilityMatrix.Avalonia.DesignData"
    xmlns:video="clr-namespace:StabilityMatrix.Avalonia.ViewModels.Inference.Video"
    x:DataType="video:SvdImgToVidConditioningViewModel">
    <Design.PreviewWith>
        <Grid MinWidth="400">
            <controls:VideoGenerationSettingsCard DataContext="{x:Static mocks:DesignData.SvdImgToVidConditioningViewModel}" />
        </Grid>
    </Design.PreviewWith>

    <Style Selector="controls|VideoGenerationSettingsCard">
        <!--  Set Defaults  -->
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <controls:Card Padding="8" HorizontalAlignment="{TemplateBinding HorizontalAlignment}">
                    <Grid
                        Margin="4"
                        ColumnDefinitions="Auto, *"
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Text="{x:Static lang:Resources.Label_Frames}" />
                        <controls1:NumberBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            HorizontalAlignment="Stretch"
                            SelectionHighlightColor="Transparent"
                            SimpleNumberFormat="F0"
                            SmallChange="1"
                            SpinButtonPlacementMode="Inline"
                            Value="{Binding NumFrames}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,8,8,0"
                            VerticalAlignment="Center"
                            Text="{x:Static lang:Resources.Label_Fps}" />
                        <controls1:NumberBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="8,8,0,0"
                            HorizontalAlignment="Stretch"
                            SelectionHighlightColor="Transparent"
                            SimpleNumberFormat="F0"
                            SmallChange="1"
                            SpinButtonPlacementMode="Inline"
                            Value="{Binding Fps}" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,8,8,0"
                            VerticalAlignment="Center"
                            Text="{x:Static lang:Resources.Label_MinCfg}" />
                        <controls1:NumberBox
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="8,8,0,0"
                            HorizontalAlignment="Stretch"
                            SelectionHighlightColor="Transparent"
                            SimpleNumberFormat="F0"
                            SmallChange="1"
                            SpinButtonPlacementMode="Inline"
                            Value="{Binding MinCfg}" />

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Margin="0,8,8,0"
                            VerticalAlignment="Center"
                            Text="{x:Static lang:Resources.Label_MotionBucketId}" />
                        <controls1:NumberBox
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="8,8,0,0"
                            HorizontalAlignment="Stretch"
                            SelectionHighlightColor="Transparent"
                            SimpleNumberFormat="F0"
                            SmallChange="1"
                            SpinButtonPlacementMode="Inline"
                            Value="{Binding MotionBucketId}" />

                        <StackPanel
                            Grid.Row="4"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="0,16,0,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock VerticalAlignment="Center" Text="{x:Static lang:Resources.Label_AugmentationLevel}" />
                                <controls1:NumberBox
                                    Grid.Column="1"
                                    MinWidth="100"
                                    Margin="4,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    SimpleNumberFormat="F2"
                                    SmallChange="0.01"
                                    SpinButtonPlacementMode="Compact"
                                    ValidationMode="InvalidInputOverwritten"
                                    Value="{Binding AugmentationLevel}" />
                            </Grid>
                            <Slider
                                Margin="0,0,0,-4"
                                Maximum="10"
                                Minimum="0"
                                TickFrequency="1"
                                TickPlacement="BottomRight"
                                Value="{Binding AugmentationLevel}" />
                        </StackPanel>
                    </Grid>
                </controls:Card>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
